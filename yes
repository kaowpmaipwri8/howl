local menuKey = Enum.KeyCode.RightControl
local menuPicking = false
local menuPickConn

local function refreshMenuKey()
    if menuPicking then
        MenuKeyText.Text = "..."
        MenuKeyText.TextColor3 = Palette.Accent
    elseif menuKey then
        MenuKeyText.Text = menuKey.Name
        MenuKeyText.TextColor3 = Palette.TextDim
    else
        MenuKeyText.Text = "UNBOUNDED"
        MenuKeyText.TextColor3 = Palette.TextDim
    end
end

MenuKeyBox.MouseButton1Click:Connect(function()
    if menuPicking then return end
    menuPicking = true
    refreshMenuKey()
    if menuPickConn then menuPickConn:Disconnect() end
    menuPickConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            menuKey = input.KeyCode
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            menuKey = Enum.UserInputType.MouseButton1
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            menuKey = Enum.UserInputType.MouseButton2
        else
            return
        end
        menuPicking = false
        refreshMenuKey()
        menuPickConn:Disconnect()
        menuPickConn = nil
    end)
end)

refreshMenuKey()

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if menuPicking then return end
    if not menuKey then return end
    if input.KeyCode == menuKey
        or (menuKey == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
        or (menuKey == Enum.UserInputType.MouseButton2 and input.UserInputType == Enum.UserInputType.MouseButton2) then
