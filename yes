-- Listbox ---------------------------------------------------
local function makeListbox(body, data)
    local items = data.Items or {}
    local default = data.Default
    local cb = data.Callback or function() end
    local flag = data.Flag
    local size = data.Size or 120
    local selected = default

    local box = Instance.new("Frame")
    box.Parent = body
    box.BackgroundColor3 = Palette.Main
    box.BorderSizePixel = 0
    box.Size = UDim2.new(1, 0, 0, size)
    box.ZIndex = Z.ElementBg
    box.LayoutOrder = #body:GetChildren()
    doubleStroke(box)
    track("Main", box, "BackgroundColor3")

    local scroll = Instance.new("ScrollingFrame")
    scroll.Parent = box
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.Position = UDim2.new(0, 4, 0, 4)
    scroll.Size = UDim2.new(1, -8, 1, -8)
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = Palette.Accent
    scroll.ScrollBarImageTransparency = 0.3
    scroll.ZIndex = Z.Hitbox
    track("Accent", scroll, "ScrollBarImageColor3")

    local layout = Instance.new("UIListLayout")
    layout.Parent = scroll
    layout.Padding = UDim.new(0, 3)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    local rows = {}

    local function refresh(newItems, newSelected)
        if newItems then items = newItems end
        if newSelected ~= nil then selected = newSelected end
        for _, r in pairs(rows) do r:Destroy() end
        rows = {}
        for i, item in ipairs(items) do
            local itemName = tostring(item)
            local b = Instance.new("TextButton")
            b.Parent = scroll
            b.Size = UDim2.new(1, 0, 0, 24)
            b.BackgroundColor3 = Palette.Main
            b.BorderSizePixel = 0
            b.Text = ""
            b.AutoButtonColor = false
            b.LayoutOrder = i
            b.Name = itemName
            b.ZIndex = Z.Hitbox
            track("Main", b, "BackgroundColor3")

            local t = label(b, itemName, 13, Palette.Text, Enum.TextXAlignment.Center, Z.ElementText)
            t.Size = UDim2.new(1, 0, 1, 0)
            t.Name = "RowText"
            if itemName == selected then
                t.TextColor3 = Palette.Accent
                track("Accent", t, "TextColor3")
            else
                track("Text", t, "TextColor3")
            end

            b.MouseButton1Click:Connect(function()
                selected = itemName
                for _, row in pairs(rows) do
                    local rt = row:FindFirstChild("RowText")
                    if rt then
                        untrack(rt)
                        if row.Name == itemName then
                            rt.TextColor3 = Palette.Accent
                            track("Accent", rt, "TextColor3")
                        else
                            rt.TextColor3 = Palette.Text
                            track("Text", rt, "TextColor3")
                        end
                    end
                end
                cb(itemName)
            end)
            table.insert(rows, b)
        end
    end
    refresh()

    local api = {
        Get = function() return selected end,
        Set = function(v) refresh(nil, tostring(v)) end,
        Refresh = function(list, sel) refresh(list, sel) end,
    }
    if flag then registerConfigElement(flag, api.Get, api.Set) end
    return api
end

