-- Toggle -----------------------------------------------------
local function makeToggle(body, data)
    local name = data.Name or "Toggle"
    local default = data.Default or false
    local cb = data.Callback or function() end
    local flag = data.Flag
    local state = default

    local row = Instance.new("TextButton")
    row.Parent = body
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, 0, 0, ROW_H)
    row.Text = ""
    row.AutoButtonColor = false
    row.ZIndex = Z.Hitbox
    row.LayoutOrder = #body:GetChildren()

    local box = Instance.new("Frame")
    box.Parent = row
    box.BackgroundColor3 = state and Palette.Accent or Palette.Main
    box.BorderSizePixel = 0
    box.AnchorPoint = Vector2.new(0, 0.5)
    box.Position = UDim2.new(0, 0, 0.5, 0)
    box.Size = UDim2.fromOffset(14, 14)
    box.ZIndex = Z.ElementBg
    doubleStroke(box)
    track(state and "Accent" or "Main", box, "BackgroundColor3")

    local lbl = label(row, name, 14, Palette.Text, Enum.TextXAlignment.Left, Z.ElementText)
    lbl.Position = UDim2.new(0, 22, 0, 0)
    lbl.Size = UDim2.new(1, -22, 1, 0)
    track("Text", lbl, "TextColor3")

    local function set(v, silent)
        state = v
        untrack(box)
        track(state and "Accent" or "Main", box, "BackgroundColor3")
        tween(box, { BackgroundColor3 = state and Palette.Accent or Palette.Main }, 0.12)
        if not silent and cb then cb(state) end
    end
    row.MouseButton1Click:Connect(function() set(not state) end)

    local api = { Set = set, Get = function() return state end }
    if flag then registerConfigElement(flag, api.Get, api.Set) end
    return api
end

-- Slider -----------------------------------------------------
local function makeSlider(body, data)
    local name = data.Name or "Slider"
    local min = data.Min or 0
    local max = data.Max or 100
    local default = data.Default or min
    local suffix = data.Suffix or ""
    local cb = data.Callback or function() end
    local flag = data.Flag

    local holder = Instance.new("Frame")
    holder.Parent = body
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Size = UDim2.new(1, 0, 0, SLIDER_H)
    holder.ZIndex = Z.ElementBg
    holder.LayoutOrder = #body:GetChildren()

    local lbl = label(holder, name, 14, Palette.Text, Enum.TextXAlignment.Left, Z.ElementText)
    lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.Size = UDim2.new(1, -60, 0, ROW_H)
    track("Text", lbl, "TextColor3")

    local valLbl = label(holder, tostring(default) .. suffix, 14, Palette.Accent, Enum.TextXAlignment.Right, Z.ElementText)
    valLbl.Position = UDim2.new(1, -60, 0, 0)
    valLbl.Size = UDim2.fromOffset(60, ROW_H)
    track("Accent", valLbl, "TextColor3")

    local track_frame = Instance.new("Frame")
    track_frame.Parent = holder
    track_frame.BackgroundColor3 = Palette.Main
    track_frame.BorderSizePixel = 0
    track_frame.Position = UDim2.new(0, 0, 0, ROW_H + 1)
    track_frame.Size = UDim2.new(1, 0, 0, 10)
    track_frame.ZIndex = Z.ElementBg
    doubleStroke(track_frame)
    track("Main", track_frame, "BackgroundColor3")

    local fill = Instance.new("Frame")
    fill.Parent = track_frame
    fill.BackgroundColor3 = Palette.Accent
    fill.BorderSizePixel = 0
    fill.Position = UDim2.new(0, 1, 0, 1)
    fill.Size = UDim2.new((default - min) / (max - min), -2, 1, -2)
    fill.ZIndex = Z.ElementFill
    track("Accent", fill, "BackgroundColor3")

    local btn = Instance.new("TextButton")
    btn.Parent = track_frame
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.Text = ""
    btn.ZIndex = Z.Hitbox

    local value = default
    local sliding = false
    local targetT = (default - min) / (max - min)
    local visualT = targetT

    local function set(v, silent)
        value = math.clamp(math.floor(v + 0.5), min, max)
        targetT = (value - min) / (max - min)
        valLbl.Text = tostring(value) .. suffix
        if not silent and cb then cb(value) end
    end

    RunService.RenderStepped:Connect(function(dt)
        local a = math.clamp(dt * 18, 0, 1)
        visualT = visualT + (targetT - visualT) * a
        local t = math.clamp(visualT, 0, 1)
        fill.Size = UDim2.new(t, -2 * t, 1, -2)
    end)

    local function move()
        local m = UserInputService:GetMouseLocation()
        local rel = math.clamp((m.X - track_frame.AbsolutePosition.X) / track_frame.AbsoluteSize.X, 0, 1)
        set(min + (max - min) * rel)
    end

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            move()
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not sliding then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            move()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    set(default, true)
    local api = { Set = set, Get = function() return value end }
    if flag then registerConfigElement(flag, api.Get, api.Set) end
    return api
end

-- Keybind ----------------------------------------------------
local function makeKeybind(body, data)
    local name = data.Name or "Keybind"
    local key = data.Default
    local cb = data.Callback or function() end
    local flag = data.Flag
    local picking = false
    local captureConn

    local row = Instance.new("Frame")
    row.Parent = body
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, ROW_H)
    row.ZIndex = Z.ElementBg
    row.LayoutOrder = #body:GetChildren()

    local lbl = label(row, name, 14, Palette.Text, Enum.TextXAlignment.Left, Z.ElementText)
    lbl.Size = UDim2.new(1, -FIELD_W - 8, 1, 0)
    track("Text", lbl, "TextColor3")

    local box = Instance.new("TextButton")
    box.Parent = row
    box.AnchorPoint = Vector2.new(1, 0.5)
    box.Position = UDim2.new(1, 0, 0.5, 0)
    box.Size = UDim2.fromOffset(FIELD_W, FIELD_H)
    box.BackgroundTransparency = 1
    box.Text = ""
    box.AutoButtonColor = false
    box.ZIndex = Z.Hitbox

    local boxText = Instance.new("TextLabel")
    boxText.Parent = box
    boxText.BackgroundTransparency = 1
    boxText.FontFace = Fonts.Gotham
    boxText.Text = "UNBOUNDED"
    boxText.TextColor3 = Palette.TextDim
    boxText.TextSize = 10
    boxText.TextXAlignment = Enum.TextXAlignment.Right
    boxText.TextYAlignment = Enum.TextYAlignment.Center
    boxText.AnchorPoint = Vector2.new(1, 0.5)
    boxText.Position = UDim2.new(1, 0, 0.5, 0)
    boxText.Size = UDim2.new(1, 0, 1, 0)
    boxText.ZIndex = Z.ElementText
    track("TextDim", boxText, "TextColor3")

    local function refresh()
        if picking then
            boxText.Text = "..."
            boxText.TextColor3 = Palette.Accent
        elseif key then
            boxText.Text = key.Name
            boxText.TextColor3 = Palette.TextDim
        else
            boxText.Text = "UNBOUNDED"
            boxText.TextColor3 = Palette.TextDim
        end
    end

    box.MouseButton1Click:Connect(function()
        if picking then return end
        picking = true
        refresh()
        if captureConn then captureConn:Disconnect() end
        captureConn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                key = input.KeyCode
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                key = Enum.UserInputType.MouseButton1
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                key = Enum.UserInputType.MouseButton2
            else
                return
            end
            picking = false
            refresh()
            captureConn:Disconnect()
            captureConn = nil
            if cb then cb(key) end
        end)
    end)
    refresh()

    local api = {
        Get = function() return key end,
        Set = function(k) key = k; refresh() end,
        Unbind = function() key = nil; refresh() end,
    }
    if flag then
        registerConfigElement(flag, function()
            return key and key.Name or nil
        end, function(v)
            if v == nil then api.Unbind()
            else
                local ok, kc = pcall(function() return Enum.KeyCode[v] end)
                if ok then api.Set(kc) end
            end
        end)
    end
    return api
end

-- Dropdown ---------------------------------------------------
local function makeDropdown(body, data)
    local name = data.Name or "Dropdown"
    local items = data.Items or {}
    local default = data.Default
    local cb = data.Callback or function() end
    local flag = data.Flag

    -- Dedupe items
    local seen = {}
    local cleanItems = {}
    for _, v in ipairs(items) do
        local k = tostring(v)
        if not seen[k] then
            seen[k] = true
            table.insert(cleanItems, k)
        end
    end
    items = cleanItems

    local value
    if default and seen[tostring(default)] then
        value = tostring(default)
    else
        value = items[1]
    end

    local FIELD_H_ACTUAL = 28
    local listH = #items * DROPDOWN_ITEM_H + DROPDOWN_LIST_PAD * 2

    local row = Instance.new("Frame")
    row.Parent = body
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, ROW_H + FIELD_H_ACTUAL)
    row.ZIndex = Z.ElementBg
    row.LayoutOrder = #body:GetChildren()

    local lbl = label(row, name, 13, Palette.Text, Enum.TextXAlignment.Left, Z.ElementText)
    lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.Size = UDim2.new(1, 0, 0, ROW_H)
    track("Text", lbl, "TextColor3")

    local field = Instance.new("TextButton")
    field.Parent = row
    field.Position = UDim2.new(0, 0, 0, ROW_H)
    field.Size = UDim2.new(1, 0, 0, FIELD_H_ACTUAL)
    field.BackgroundColor3 = Palette.Main
    field.BorderSizePixel = 0
    field.AutoButtonColor = false
    field.Text = ""
    field.ZIndex = Z.Hitbox
    track("Main", field, "BackgroundColor3")

    local fieldBorder = frameBorder(field,
        { top = true, left = true, right = true, bottom = true },
        Palette.Outline, Palette.Inline, Z.Hitbox + 1)
    track("Outline", fieldBorder.oL, "BackgroundColor3")
    track("Outline", fieldBorder.oR, "BackgroundColor3")
    track("Outline", fieldBorder.oT, "BackgroundColor3")
    track("Outline", fieldBorder.oB, "BackgroundColor3")
    track("Inline",  fieldBorder.iL, "BackgroundColor3")
    track("Inline",  fieldBorder.iR, "BackgroundColor3")
    track("Inline",  fieldBorder.iT, "BackgroundColor3")
    track("Inline",  fieldBorder.iB, "BackgroundColor3")

    local fieldText = Instance.new("TextLabel")
    fieldText.Parent = field
    fieldText.BackgroundTransparency = 1
    fieldText.Position = UDim2.new(0, 0, 0, 0)
    fieldText.Size = UDim2.new(1, 0, 1, 0)
    fieldText.FontFace = Fonts.Gotham
    fieldText.TextSize = 13
    fieldText.TextColor3 = Palette.Text
    fieldText.TextXAlignment = Enum.TextXAlignment.Center
    fieldText.TextYAlignment = Enum.TextYAlignment.Center
    fieldText.TextTruncate = Enum.TextTruncate.AtEnd
    fieldText.Text = value or "Select…"
    fieldText.ZIndex = Z.ElementText
    padTop(fieldText, TEXT_Y_NUDGE)
    track("Text", fieldText, "TextColor3")

    local chevron = Instance.new("ImageLabel")
    chevron.Parent = field
    chevron.BackgroundTransparency = 1
    chevron.AnchorPoint = Vector2.new(1, 0.5)
    chevron.Position = UDim2.new(1, -8, 0.5, 0)
    chevron.Size = UDim2.fromOffset(24, 24)
    chevron.Image = CHEVRON_IMG
    chevron.ImageColor3 = Color3.new(1, 1, 1)
    chevron.Rotation = 0
    chevron.ScaleType = Enum.ScaleType.Fit
    chevron.ZIndex = Z.ElementText
    chevron.Active = false
    chevron.Interactable = false

    -- List overlay, parented to Home so it can overhang
    local list = Instance.new("Frame")
    list.Parent = windowState.home
    list.BackgroundColor3 = Palette.Main
    list.BorderSizePixel = 0
    list.Size = UDim2.fromOffset(0, 0)
    list.ZIndex = Z.Overlay
    list.ClipsDescendants = true
    list.Visible = false
    track("Main", list, "BackgroundColor3")
    local listBorder = frameBorder(list,
        { left = true, right = true, bottom = true },
        Palette.Outline, Palette.Inline, Z.Overlay + 1)
    track("Outline", listBorder.oL, "BackgroundColor3")
    track("Outline", listBorder.oR, "BackgroundColor3")
    track("Outline", listBorder.oB, "BackgroundColor3")
    track("Inline",  listBorder.iL, "BackgroundColor3")
    track("Inline",  listBorder.iR, "BackgroundColor3")
    track("Inline",  listBorder.iB, "BackgroundColor3")

    local optionsHolder = Instance.new("Frame")
    optionsHolder.Parent = list
    optionsHolder.BackgroundTransparency = 1
    optionsHolder.Size = UDim2.new(1, 0, 1, 0)
    optionsHolder.ZIndex = Z.Overlay + 2

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, DROPDOWN_LIST_PAD)
    pad.PaddingBottom = UDim.new(0, DROPDOWN_LIST_PAD)
    pad.Parent = optionsHolder

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 0)
    listLayout.Parent = optionsHolder

    local optionButtons = {}

    local function paintOptions()
        for optName, d in pairs(optionButtons) do
            untrack(d.label)
            if optName == value then
                d.label.TextColor3 = Palette.Accent
                track("Accent", d.label, "TextColor3")
            else
                d.label.TextColor3 = Palette.Text
                track("Text", d.label, "TextColor3")
            end
        end
    end

    local function selectOption(optName, silent)
        optName = tostring(optName)
        if not seen[optName] then return end
        value = optName
        fieldText.Text = optName
        paintOptions()
        if not silent and cb then cb(value) end
    end

    -- dd table must exist before addOption uses it
    local dd = {
        opened = false,
        field = field,
        list = list,
    }

    local function positionList()
        local homeAbs = windowState.home.AbsolutePosition
        local fAbs = field.AbsolutePosition
        local fSize = field.AbsoluteSize
        list.Position = UDim2.fromOffset(
            fAbs.X - homeAbs.X,
            fAbs.Y - homeAbs.Y + fSize.Y
        )
        list.Size = UDim2.new(0, fSize.X, 0, listH)
    end

    function dd:setOpen(o)
        if self.opened == o then return end
        if o then
            positionList()
            list.Visible = true
            fieldBorder.oB.Visible = false
            fieldBorder.iB.Visible = false
            tween(chevron, { Rotation = 180 }, 0.15)
        else
            list.Visible = false
            fieldBorder.oB.Visible = true
            fieldBorder.iB.Visible = true
            tween(chevron, { Rotation = 0 }, 0.15)
        end
        self.opened = o
    end

    local function addOption(optName, order)
        local btn = Instance.new("TextButton")
        btn.Parent = optionsHolder
        btn.Size = UDim2.new(1, 0, 0, DROPDOWN_ITEM_H)
        btn.BackgroundTransparency = 1
        btn.AutoButtonColor = false
        btn.Text = ""
        btn.LayoutOrder = order
        btn.ZIndex = Z.Overlay + 3

        local optText = Instance.new("TextLabel")
        optText.Parent = btn
        optText.BackgroundTransparency = 1
        optText.Size = UDim2.new(1, 0, 1, 0)
        optText.FontFace = Fonts.Gotham
        optText.TextSize = 13
        optText.Text = tostring(optName)
        optText.TextColor3 = (tostring(optName) == value) and Palette.Accent or Palette.Text
        optText.TextXAlignment = Enum.TextXAlignment.Center
        optText.TextYAlignment = Enum.TextYAlignment.Center
        optText.ZIndex = Z.OverlayText
        optText.Active = false
        optText.Interactable = false
        padTop(optText, TEXT_Y_NUDGE)
        track("Text", optText, "TextColor3")

        btn.MouseEnter:Connect(function()
            btn.BackgroundColor3 = Palette.Inline
            btn.BackgroundTransparency = 0
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundTransparency = 1
        end)
        btn.MouseButton1Click:Connect(function()
            selectOption(optName)
            dd:setOpen(false)
        end)

        optionButtons[tostring(optName)] = { btn = btn, label = optText }
    end

    for i, opt in ipairs(items) do
        addOption(opt, i)
    end

    field.MouseButton1Click:Connect(function()
        dd:setOpen(not dd.opened)
    end)

    -- Register for outside-click dismissal
    table.insert(dismissables, {
        isOpen = function() return dd.opened end,
        close = function() dd:setOpen(false) end,
        isInside = function(pos)
            local function inside(g)
                if not g or not g.Parent then return false end
                local a, sz = g.AbsolutePosition, g.AbsoluteSize
                return pos.X >= a.X and pos.X <= a.X + sz.X
                   and pos.Y >= a.Y and pos.Y <= a.Y + sz.Y
            end
            return inside(field) or inside(list)
        end,
    })

    -- Reposition when the window moves
    table.insert(windowState.openOverlays, function()
        if dd.opened then positionList() end
    end)

    local api = {
        Set = function(v) selectOption(v) end,
        Get = function() return value end,
        Row = row,
    }
    if flag then registerConfigElement(flag, api.Get, api.Set) end
    return api
end

-- Colorpicker -----------------------------------------------
local function makeColorpicker(body, data)
    local name = data.Name or "Color"
    local color = data.Default or Color3.fromRGB(255, 226, 3)
    local cb = data.Callback or function() end
    local flag = data.Flag
    local h, s, v = color:ToHSV()

    local row = Instance.new("Frame")
    row.Parent = body
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, ROW_H)
    row.ZIndex = Z.ElementBg
    row.LayoutOrder = #body:GetChildren()

    local lbl = label(row, name, 14, Palette.Text, Enum.TextXAlignment.Left, Z.ElementText)
    lbl.Size = UDim2.new(1, -FIELD_W - 8, 1, 0)
    track("Text", lbl, "TextColor3")

    local swatch = Instance.new("TextButton")
    swatch.Parent = row
    swatch.AnchorPoint = Vector2.new(1, 0.5)
    swatch.Position = UDim2.new(1, 0, 0.5, 0)
    swatch.Size = UDim2.fromOffset(28, 14)
    swatch.BackgroundColor3 = color
    swatch.BorderSizePixel = 0
    swatch.Text = ""
    swatch.AutoButtonColor = false
    swatch.ZIndex = Z.Hitbox
    doubleStroke(swatch)

    local PANEL_W = 150
    local SV_PAD = 10
    local svSize = PANEL_W - SV_PAD * 2
    local HUE_H = 10
    local GAP_V = 8
    local HEX_H = 22
    local HEX_GAP = 6
    local PANEL_H = SV_PAD + svSize + GAP_V + HUE_H + HEX_GAP + HEX_H + SV_PAD

    local popup = Instance.new("Frame")
    popup.Parent = windowState.home
    popup.BackgroundColor3 = Palette.Main
    popup.BorderSizePixel = 0
    popup.Size = UDim2.fromOffset(PANEL_W, PANEL_H)
    popup.Visible = false
    popup.ZIndex = Z.Overlay
    doubleStroke(popup)
    track("Main", popup, "BackgroundColor3")

    local sv = Instance.new("Frame")
    sv.Parent = popup
    sv.Position = UDim2.new(0, SV_PAD, 0, SV_PAD)
    sv.Size = UDim2.fromOffset(svSize, svSize)
    sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    sv.BorderSizePixel = 0
    sv.ClipsDescendants = true
    sv.ZIndex = Z.Overlay + 1
    stroke(sv, Palette.Outline, 1)

    local white = Instance.new("Frame")
    white.Parent = sv
    white.BackgroundColor3 = Color3.new(1, 1, 1)
    white.BorderSizePixel = 0
    white.Size = UDim2.new(1, 0, 1, 0)
    white.ZIndex = Z.Overlay + 2
    local wg = Instance.new("UIGradient")
    wg.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1),
    }
    wg.Parent = white

    local black = Instance.new("Frame")
    black.Parent = sv
    black.BackgroundColor3 = Color3.new(0, 0, 0)
    black.BorderSizePixel = 0
    black.Size = UDim2.new(1, 0, 1, 0)
    black.ZIndex = Z.Overlay + 3
    local bg = Instance.new("UIGradient")
    bg.Rotation = 90
    bg.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    }
    bg.Parent = black

    local svCursor = Instance.new("Frame")
    svCursor.Parent = sv
    svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
    svCursor.Size = UDim2.fromOffset(4, 4)
    svCursor.BackgroundColor3 = Palette.Outline
    svCursor.ZIndex = Z.Overlay + 4
    Instance.new("UICorner", svCursor).CornerRadius = UDim.new(0.5, 0)

    local svBtn = Instance.new("TextButton")
    svBtn.Parent = sv
    svBtn.BackgroundTransparency = 1
    svBtn.Size = UDim2.new(1, 0, 1, 0)
    svBtn.Text = ""
    svBtn.ZIndex = Z.Overlay + 5

    local hue = Instance.new("Frame")
    hue.Parent = popup
    hue.Position = UDim2.new(0, SV_PAD, 0, SV_PAD + svSize + GAP_V)
    hue.Size = UDim2.fromOffset(svSize, HUE_H)
    hue.BackgroundColor3 = Color3.new(1, 1, 1)
    hue.ZIndex = Z.Overlay + 1
    stroke(hue, Palette.Outline, 1)
    local hg = Instance.new("UIGradient")
    hg.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
    }
    hg.Parent = hue

    local hueCursor = Instance.new("Frame")
    hueCursor.Parent = hue
    hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
    hueCursor.Size = UDim2.fromOffset(4, 4)
    hueCursor.BackgroundColor3 = Palette.Outline
    hueCursor.ZIndex = Z.Overlay + 4
    Instance.new("UICorner", hueCursor).CornerRadius = UDim.new(0.5, 0)

    local hueBtn = Instance.new("TextButton")
    hueBtn.Parent = hue
    hueBtn.BackgroundTransparency = 1
    hueBtn.Size = UDim2.new(1, 0, 1, 0)
    hueBtn.Text = ""
    hueBtn.ZIndex = Z.Overlay + 5

    local hexOverlay = Instance.new("Frame")
    hexOverlay.Parent = popup
    hexOverlay.BackgroundColor3 = Palette.Main
    hexOverlay.BorderSizePixel = 0
    hexOverlay.Position = UDim2.new(0, SV_PAD, 0, SV_PAD + svSize + GAP_V + HUE_H + HEX_GAP)
    hexOverlay.Size = UDim2.fromOffset(svSize, HEX_H)
    hexOverlay.ZIndex = Z.Overlay + 2
    doubleStroke(hexOverlay)
    track("Main", hexOverlay, "BackgroundColor3")

    local hexBox = Instance.new("TextBox")
    hexBox.Parent = hexOverlay
    hexBox.Position = UDim2.new(0, 2, 0, 2)
    hexBox.Size = UDim2.new(1, -4, 1, -4)
    hexBox.BackgroundTransparency = 1
    hexBox.FontFace = Fonts.Gotham
    hexBox.TextSize = 13
    hexBox.TextColor3 = Palette.Text
    hexBox.Text = string.format("#%02X%02X%02X",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5))
    hexBox.ClearTextOnFocus = false
    hexBox.TextXAlignment = Enum.TextXAlignment.Center
    hexBox.TextYAlignment = Enum.TextYAlignment.Center
    hexBox.ZIndex = Z.OverlayText
    padTop(hexBox, TEXT_Y_NUDGE - 2)
    track("Text", hexBox, "TextColor3")

    local cp = { opened = false }

    local function update(silent)
        color = Color3.fromHSV(h, s, v)
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
        swatch.BackgroundColor3 = color
        hexBox.Text = string.format("#%02X%02X%02X",
            math.floor(color.R * 255 + 0.5),
            math.floor(color.G * 255 + 0.5),
            math.floor(color.B * 255 + 0.5))
        if not silent and cb then cb(color) end
    end

    local function positionPopup()
        local homeAbs = windowState.home.AbsolutePosition
        local swAbs = swatch.AbsolutePosition
        local swSize = swatch.AbsoluteSize
        local px = (swAbs.X - homeAbs.X) + swSize.X - PANEL_W
        local py = (swAbs.Y - homeAbs.Y) + swSize.Y + 4
        local homeSize = windowState.home.AbsoluteSize
        if px < 4 then px = 4 end
        if px + PANEL_W > homeSize.X - 4 then px = homeSize.X - PANEL_W - 4 end
        if py + PANEL_H > homeSize.Y - 4 then py = (swAbs.Y - homeAbs.Y) - PANEL_H - 4 end
        if py < 4 then py = 4 end
        popup.Position = UDim2.fromOffset(px, py)
    end

    function cp:setOpen(o)
        if self.opened == o then return end
        if o then
            positionPopup()
            popup.Visible = true
        else
            popup.Visible = false
        end
        self.opened = o
    end

    swatch.MouseButton1Click:Connect(function()
        cp:setOpen(not cp.opened)
    end)

    local draggingSV = false
    local function svInput(px, py)
        s = math.clamp((px - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
        v = math.clamp(1 - (py - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
        update()
    end
    svBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true
            svInput(input.Position.X, input.Position.Y)
        end
    end)

    local draggingHue = false
    local function hueInput(px)
        h = math.clamp((px - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
        update()
    end
    hueBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            hueInput(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSV then svInput(input.Position.X, input.Position.Y) end
            if draggingHue then hueInput(input.Position.X) end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = false
            draggingHue = false
        end
    end)

    hexBox.FocusLost:Connect(function()
        local hx = hexBox.Text:gsub("#", ""):gsub(" ", "")
        if #hx == 6 then
            local ok, c = pcall(function() return Color3.fromHex(hx) end)
            if ok and c then
                color = c
                h, s, v = color:ToHSV()
                update(false)
                return
            end
        end
        update(true)
    end)

    -- Outside-click close
    table.insert(dismissables, {
        isOpen = function() return cp.opened end,
        close = function() cp:setOpen(false) end,
        isInside = function(pos)
            local function inside(g)
                if not g or not g.Parent then return false end
                local a, sz = g.AbsolutePosition, g.AbsoluteSize
                return pos.X >= a.X and pos.X <= a.X + sz.X
                   and pos.Y >= a.Y and pos.Y <= a.Y + sz.Y
            end
            return inside(swatch) or inside(popup)
        end,
    })

    table.insert(windowState.openOverlays, function()
        if cp.opened then positionPopup() end
    end)

    update(true)

    local api = {
        Set = function(c)
            color = c
            h, s, v = color:ToHSV()
            update()
        end,
        Get = function() return color end,
    }
    if flag then registerConfigElement(flag, api.Get, api.Set) end
    return api
end

