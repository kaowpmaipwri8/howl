local function makeSection(parentTab, title, side, gapOverride)
    local Section = Instance.new("Frame")
    Section.Parent = parentTab
    Section.BackgroundColor3 = Palette.Main
    Section.BackgroundTransparency = SECTION_BG_TRANSPARENCY
    Section.BorderSizePixel = 0
    Section.ZIndex = 3
    Section.AutomaticSize = Enum.AutomaticSize.Y
    if side == "full" then
        Section.Position = UDim2.new(0, PAD, 0, SECTION_Y)
        Section.Size = UDim2.new(1, -PAD * 2, 0, 0)
    else
        if side == 0 then
            Section.Position = UDim2.new(0, PAD, 0, SECTION_Y)
        else
            Section.Position = UDim2.new(0.5, PAD * 0.5, 0, SECTION_Y)
        end
        Section.Size = UDim2.new(0.5, -PAD * 1.5, 0, 0)
    end
    doubleStroke(Section)
    track("Main", Section, "BackgroundColor3")
    local SectionLine = Instance.new("Frame")
    SectionLine.Name = "SectionLine"
    SectionLine.Parent = Section
    SectionLine.BackgroundColor3 = Palette.Accent
    SectionLine.BorderSizePixel = 0
    SectionLine.Position = UDim2.new(0, 1, 0, 1)
    SectionLine.Size = UDim2.new(1, -2, 0, 1)
    SectionLine.ZIndex = 8
    SectionLine.Active = false
    SectionLine.Interactable = false
    track("Accent", SectionLine, "BackgroundColor3")
    local UIGradient = Instance.new("UIGradient")
    UIGradient.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0.00, 0.00),
        NumberSequenceKeypoint.new(0.00, 0.99),
        NumberSequenceKeypoint.new(0.50, 0.02),
        NumberSequenceKeypoint.new(1.00, 0.98),
        NumberSequenceKeypoint.new(1.00, 0.00),
    }
    UIGradient.Parent = SectionLine
    local SectionName = label(Section, title, 14, Palette.Text, Enum.TextXAlignment.Center)
    SectionName.Position = UDim2.new(0, 0, 0, 0)
    SectionName.Size = UDim2.new(1, 0, 0, HEADER_H)
    SectionName.ZIndex = 7
    SectionName.Active = false
    SectionName.Interactable = false
    track("Text", SectionName, "TextColor3")
    local body = Instance.new("Frame")
    body.Parent = Section
    body.BackgroundTransparency = 1
    body.BorderSizePixel = 0
    body.Position = UDim2.new(0, PAD, 0, HEADER_H)
    body.Size = UDim2.new(1, -PAD * 2, 0, PAD)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.ZIndex = 6
    body.Active = true
    body.Interactable = true
    local list = Instance.new("UIListLayout")
    list.Parent = body
    list.Padding = UDim.new(0, gapOverride or GAP)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.HorizontalAlignment = Enum.HorizontalAlignment.Center
    list.VerticalAlignment = Enum.VerticalAlignment.Top
    local pad = Instance.new("UIPadding")
    pad.Parent = body
    pad.PaddingBottom = UDim.new(0, PAD)
    return { Frame = Section, Body = body, Layout = list }
end

