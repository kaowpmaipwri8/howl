    swatch.AutoButtonColor = false
    swatch.ZIndex = 100
    swatch.Active = true
    swatch.Interactable = true
    doubleStroke(swatch)
    local PANEL_W = 150
    local SV_PAD = 10
    local svSize = PANEL_W - SV_PAD * 2
    local HUE_H = 10
    local GAP_V = 8
    local HEX_H = 22
    local HEX_GAP = 6
    local PANEL_H = SV_PAD + svSize + GAP_V + HUE_H + HEX_GAP + HEX_H + SV_PAD
    local popup = Instance.new("Frame")
    popup.Parent = fadeHome
    popup.BackgroundColor3 = Palette.Main
    popup.BackgroundTransparency = 0
    popup.BorderSizePixel = 0
    popup.Size = UDim2.new(0, PANEL_W, 0, PANEL_H)
    popup.Visible = false
    popup.ZIndex = 400
    popup.ClipsDescendants = false
    doubleStroke(popup)
    track("Main", popup, "BackgroundColor3")
    local sv = Instance.new("Frame")
    sv.Parent = popup
    sv.Position = UDim2.new(0, SV_PAD, 0, SV_PAD)
    sv.Size = UDim2.new(0, svSize, 0, svSize)
    sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    sv.BorderSizePixel = 0
    sv.ClipsDescendants = true
    sv.ZIndex = 402
    stroke(sv, Palette.Outline, 1)
    local white = Instance.new("Frame")
    white.Parent = sv
    white.BackgroundColor3 = Color3.new(1, 1, 1)
    white.BorderSizePixel = 0
    white.Size = UDim2.new(1, 0, 1, 0)
    white.ZIndex = 403
    white.Active = false
    white.Interactable = false
    local wg = Instance.new("UIGradient")
    wg.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1),
    }
    wg.Parent = white
    local black = Instance.new("Frame")
    black.Parent = sv
    black.BackgroundColor3 = Color3.new(0, 0, 0)
    black.BorderSizePixel = 0
    black.Size = UDim2.new(1, 0, 1, 0)
    black.ZIndex = 404
    black.Active = false
    black.Interactable = false
    local bg = Instance.new("UIGradient")
    bg.Rotation = 90
    bg.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    }
    bg.Parent = black
    local svCursor = Instance.new("Frame")
    svCursor.Parent = sv
    svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
    svCursor.Size = UDim2.new(0, 4, 0, 4)
    svCursor.BackgroundColor3 = Palette.Outline
    svCursor.BorderSizePixel = 0
    svCursor.ZIndex = 406
    svCursor.Active = false
    svCursor.Interactable = false
    local svCorner = Instance.new("UICorner")
    svCorner.CornerRadius = UDim.new(0.5, 0)
    svCorner.Parent = svCursor
    local svcStroke = Instance.new("UIStroke")
    svcStroke.Color = Color3.new(1, 1, 1)
    svcStroke.Thickness = 1
    svcStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    svcStroke.LineJoinMode = Enum.LineJoinMode.Round
    svcStroke.Transparency = 0.15
    svcStroke.Parent = svCursor
    local svBtn = Instance.new("TextButton")
    svBtn.Parent = sv
    svBtn.BackgroundTransparency = 1
    svBtn.Size = UDim2.new(1, 0, 1, 0)
    svBtn.Text = ""
    svBtn.ZIndex = 407
    svBtn.Active = true
    svBtn.Interactable = true
    local hue = Instance.new("Frame")
    hue.Parent = popup
    hue.Position = UDim2.new(0, SV_PAD, 0, SV_PAD + svSize + GAP_V)
    hue.Size = UDim2.new(0, svSize, 0, HUE_H)
    hue.BackgroundColor3 = Color3.new(1, 1, 1)
    hue.BorderSizePixel = 0
    hue.ZIndex = 402
    stroke(hue, Palette.Outline, 1)
    local hg = Instance.new("UIGradient")
    hg.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
    }
    hg.Parent = hue
    local hueCursor = Instance.new("Frame")
    hueCursor.Parent = hue
    hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
    hueCursor.Size = UDim2.new(0, 4, 0, 4)
    hueCursor.BackgroundColor3 = Palette.Outline
    hueCursor.BorderSizePixel = 0
    hueCursor.ZIndex = 406
    hueCursor.Active = false
    hueCursor.Interactable = false
    local hCorner = Instance.new("UICorner")
    hCorner.CornerRadius = UDim.new(0.5, 0)
    hCorner.Parent = hueCursor
    local hcStroke = Instance.new("UIStroke")
    hcStroke.Color = Color3.new(1, 1, 1)
    hcStroke.Thickness = 1
    hcStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    hcStroke.LineJoinMode = Enum.LineJoinMode.Round
    hcStroke.Transparency = 0.15
    hcStroke.Parent = hueCursor
    local hueBtn = Instance.new("TextButton")
    hueBtn.Parent = hue
    hueBtn.BackgroundTransparency = 1
    hueBtn.Size = UDim2.new(1, 0, 1, 0)
    hueBtn.Text = ""
    hueBtn.ZIndex = 407
    hueBtn.Active = true
    hueBtn.Interactable = true
    local hexOverlay = Instance.new("Frame")
    hexOverlay.Parent = popup
    hexOverlay.BackgroundColor3 = Palette.Main
    hexOverlay.BackgroundTransparency = 0
    hexOverlay.BorderSizePixel = 0
    hexOverlay.Position = UDim2.new(0, SV_PAD, 0, SV_PAD + svSize + GAP_V + HUE_H + HEX_GAP)
    hexOverlay.Size = UDim2.new(0, svSize, 0, HEX_H)
    hexOverlay.ZIndex = 410
    doubleStroke(hexOverlay)
    track("Main", hexOverlay, "BackgroundColor3")
    local hexBox = Instance.new("TextBox")
    hexBox.Parent = hexOverlay
    hexBox.Position = UDim2.new(0, 2, 0, 2)
    hexBox.Size = UDim2.new(1, -4, 1, -4)
    hexBox.BackgroundTransparency = 1
    hexBox.BorderSizePixel = 0
    hexBox.FontFace = Fonts.Gotham
    hexBox.TextSize = 13
    hexBox.TextColor3 = Palette.Text
    hexBox.Text = string.format("#%02X%02X%02X",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5))
    hexBox.ClearTextOnFocus = false
    hexBox.TextXAlignment = Enum.TextXAlignment.Center
    hexBox.TextYAlignment = Enum.TextYAlignment.Center
    hexBox.ZIndex = 413
    track("Text", hexBox, "TextColor3")
    local hexNudge = Instance.new("UIPadding")
    hexNudge.PaddingTop = UDim.new(0, TEXT_Y_NUDGE - 2)
    hexNudge.Parent = hexBox
    local function update(silent)
        color = Color3.fromHSV(h, s, v)
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
        swatch.BackgroundColor3 = color
        hexBox.Text = string.format("#%02X%02X%02X",
            math.floor(color.R * 255 + 0.5),
            math.floor(color.G * 255 + 0.5),
            math.floor(color.B * 255 + 0.5))
        if not silent and cb then cb(color) end
    end
    local function positionPopup()
        local homeAbs = fadeHome.AbsolutePosition
        local swAbs = swatch.AbsolutePosition
        local swSize = swatch.AbsoluteSize
        local px = (swAbs.X - homeAbs.X) + swSize.X - PANEL_W
        local py = (swAbs.Y - homeAbs.Y) + swSize.Y + 4
        local homeSize = fadeHome.AbsoluteSize
        if px < 4 then px = 4 end
        if px + PANEL_W > homeSize.X - 4 then px = homeSize.X - PANEL_W - 4 end
        if py + PANEL_H > homeSize.Y - 4 then py = (swAbs.Y - homeAbs.Y) - PANEL_H - 4 end
        if py < 4 then py = 4 end
        popup.Position = UDim2.fromOffset(px, py)
    end
    local cp = { opened = false, swatch = swatch, popup = popup }
    function cp:setOpen(o)
        if self.opened == o then return end
        if o then
            positionPopup()
            popup.Visible = true
        else
            popup.Visible = false
        end
        self.opened = o
    end
    swatch.MouseButton1Click:Connect(function()
        cp:setOpen(not cp.opened)
    end)
    local draggingSV = false
    local function svInputFromPos(px, py)
        s = math.clamp((px - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
        v = math.clamp(1 - (py - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
        update()
    end
    svBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true
            svInputFromPos(input.Position.X, input.Position.Y)
        end
    end)
    local draggingHue = false
    local function hueInputFromPos(px)
        h = math.clamp((px - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
        update()
    end
    hueBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            hueInputFromPos(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSV then svInputFromPos(input.Position.X, input.Position.Y) end
            if draggingHue then hueInputFromPos(input.Position.X) end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = false
            draggingHue = false
        end
    end)
    hexBox.FocusLost:Connect(function()
        local hx = hexBox.Text:gsub("#", ""):gsub(" ", "")
        if #hx == 6 then
            local ok, c = pcall(function() return Color3.fromHex(hx) end)
            if ok and c then
                color = c
                h, s, v = color:ToHSV()
                update(false)
                return
            end
        end
        update(true)
    end)
    local function closeOnClickOutside(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if not cp.opened then return end
        local pos = input.Position
        local function inside(g)
            if not g or not g.Parent then return false end
            local a, sz = g.AbsolutePosition, g.AbsoluteSize
            return pos.X >= a.X and pos.X <= a.X + sz.X
               and pos.Y >= a.Y and pos.Y <= a.Y + sz.Y
        end
        if not (inside(swatch) or inside(popup)) then
            cp:setOpen(false)
        end
    end
    UserInputService.InputBegan:Connect(closeOnClickOutside)
    update(true)
    local api = {
        Set = function(c)
            color = c
            h, s, v = color:ToHSV()
            update()
        end,
        Get = function() return color end,
    }
    if flag then registerConfigElement(flag, api.Get, api.Set, "colorpicker") end
    return api
end

