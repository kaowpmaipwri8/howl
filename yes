    valLbl.Position = UDim2.new(1, -60, 0, 0)
    valLbl.Size = UDim2.new(0, 60, 0, ROW_H)
    valLbl.ZIndex = 7
    valLbl.Active = false
    valLbl.Interactable = false
    track("Accent", valLbl, "TextColor3")
    local track_frame = Instance.new("Frame")
    track_frame.Parent = holder
    track_frame.BackgroundColor3 = Palette.Main
    track_frame.BackgroundTransparency = 0
    track_frame.BorderSizePixel = 0
    track_frame.Position = UDim2.new(0, 0, 0, ROW_H + 1)
    track_frame.Size = UDim2.new(1, 0, 0, 10)
    track_frame.ZIndex = 7
    doubleStroke(track_frame)
    track("Main", track_frame, "BackgroundColor3")
    local fill = Instance.new("Frame")
    fill.Parent = track_frame
    fill.BackgroundColor3 = Palette.Accent
    fill.BorderSizePixel = 0
    fill.Position = UDim2.new(0, 1, 0, 1)
    fill.Size = UDim2.new((default - min) / (max - min), -2, 1, -2)
    fill.ZIndex = 8
    fill.Active = false
    fill.Interactable = false
    track("Accent", fill, "BackgroundColor3")
    local btn = Instance.new("TextButton")
    btn.Parent = track_frame
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.Text = ""
    btn.ZIndex = 10
    btn.Active = true
    btn.Interactable = true
    local value = default
    local sliding = false
    local targetT = (default - min) / (max - min)
    local visualT = targetT
    local function set(v, silent)
        value = math.clamp(math.floor(v + 0.5), min, max)
        targetT = (value - min) / (max - min)
        valLbl.Text = tostring(value) .. suffix
        if not silent and cb then cb(value) end
    end
    RunService.RenderStepped:Connect(function(dt)
        local a = math.clamp(dt * 18, 0, 1)
        visualT = visualT + (targetT - visualT) * a
        local t = math.clamp(visualT, 0, 1)
        fill.Size = UDim2.new(t, -2 * t, 1, -2)
    end)
    local function move()
        local m = UserInputService:GetMouseLocation()
        local rel = math.clamp((m.X - track_frame.AbsolutePosition.X) / track_frame.AbsoluteSize.X, 0, 1)
        set(min + (max - min) * rel)
    end
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            move()
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not sliding then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            move()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    set(default, true)
    return { Set = set, Get = function() return value end, Row = holder, Name = name }
end

