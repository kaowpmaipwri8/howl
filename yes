-- ============================================================
-- Z-INDEX POLICY (single source of truth)
-- ============================================================
--  0-9   : backgrounds / panels (window, content, sections)
--  10-19 : section decorations / lines
--  20-49 : static labels
--  50-79 : element visuals (toggle box, slider track/fill)
--  80-99 : leaf interactive hitboxes (buttons, toggles, tabs)
--  100+  : floating overlays (dropdown list, colorpicker popup)
local Z = {
    Background   = 1,
    Panel        = 3,
    SectionLine  = 10,
    SectionLabel = 20,
    StaticLabel  = 25,
    ElementBg    = 50,
    ElementFill  = 55,
    ElementText  = 60,
    Hitbox       = 80,
    Tab          = 85,
    TitleLabel   = 30,
    DragStrip    = 40,
    Overlay      = 100,
    OverlayText  = 110,
}

-- ============================================================
-- UI HELPERS
-- ============================================================
local function stroke(frame, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Palette.Outline
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.LineJoinMode = Enum.LineJoinMode.Miter
    s.Parent = frame
    return s
end

local function doubleStroke(frame)
    stroke(frame, Palette.Outline, 1)
    local ins = Instance.new("Frame")
    ins.Parent = frame
    ins.BackgroundTransparency = 1
    ins.BorderSizePixel = 0
    ins.Position = UDim2.new(0, 1, 0, 1)
    ins.Size = UDim2.new(1, -2, 1, -2)
    ins.ZIndex = frame.ZIndex + 1
    ins.Active = false
    ins.Interactable = false
    stroke(ins, Palette.Inline, 1)
    return ins
end

local function edge(parent, posU, sizeU, color, z)
    local f = Instance.new("Frame")
    f.BackgroundColor3 = color
    f.BorderSizePixel = 0
    f.Position = posU
    f.Size = sizeU
    f.ZIndex = z
    f.Active = false
    f.Interactable = false
    f.Parent = parent
    return f
end

local function frameBorder(parent, edges, outerColor, innerColor, zBase)
    local result = {}
    zBase = zBase or Z.Overlay
    if edges.left then
        result.oL = edge(parent, UDim2.new(0, 0, 0, 0), UDim2.new(0, 1, 1, 0), outerColor, zBase)
        result.iL = edge(parent, UDim2.new(0, 1, 0, 0), UDim2.new(0, 1, 1, 0), innerColor, zBase + 1)
    end
    if edges.right then
        result.oR = edge(parent, UDim2.new(1, -1, 0, 0), UDim2.new(0, 1, 1, 0), outerColor, zBase)
        result.iR = edge(parent, UDim2.new(1, -2, 0, 0), UDim2.new(0, 1, 1, 0), innerColor, zBase + 1)
    end
    if edges.top then
        result.oT = edge(parent, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 1), outerColor, zBase)
        result.iT = edge(parent, UDim2.new(0, 1, 0, 1), UDim2.new(1, -2, 0, 1), innerColor, zBase + 1)
    end
    if edges.bottom then
        result.oB = edge(parent, UDim2.new(0, 0, 1, -1), UDim2.new(1, 0, 0, 1), outerColor, zBase)
        result.iB = edge(parent, UDim2.new(0, 1, 1, -2), UDim2.new(1, -2, 0, 1), innerColor, zBase + 1)
    end
    return result
end

local function label(parent, text, size, color, align, z)
    local l = Instance.new("TextLabel")
    l.Parent = parent
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.FontFace = Fonts.Gotham
    l.Text = text
    l.TextColor3 = color or Palette.Text
    l.TextSize = size or 14
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextWrapped = false
    l.ZIndex = z or Z.StaticLabel
    return l
end

local function tween(inst, props, time, style)
    local info = TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(inst, info, props):Play()
end

local function padTop(lbl, px)
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, px or TEXT_Y_NUDGE)
    pad.Parent = lbl
    return pad
end

-- ============================================================
-- THEME TRACKING
-- ============================================================
local themeMap = {
    Main = {}, Inline = {}, Accent = {}, Text = {}, TextDim = {}, Outline = {},
}
local function track(role, obj, prop)
    if not themeMap[role] then themeMap[role] = {} end
    table.insert(themeMap[role], { obj = obj, prop = prop })
end
local function untrack(obj)
    for _, list in pairs(themeMap) do
        for i = #list, 1, -1 do
            if list[i].obj == obj then
                table.remove(list, i)
            end
        end
    end
end

local configRegistry = {}
local function registerConfigElement(name, getter, setter)
    table.insert(configRegistry, { Name = name, Get = getter, Set = setter })
end

local function applyRole(role, c)
    Palette[role] = c
    local list = themeMap[role]
    if not list then return end
    for _, t in ipairs(list) do
        if t.obj and t.obj.Parent then
            pcall(function() t.obj[t.prop] = c end)
        end
    end
end

