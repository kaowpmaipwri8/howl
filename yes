local Tab = {}
Tab.__index = Tab

function Tab:Section(data)
    local name = data.Name or "Section"
    local side = data.Side or 0
    local gapOverride = data.Gap or GAP
    local s = Instance.new("Frame")
    s.Parent = self.Page
    s.BackgroundColor3 = Palette.Main
    s.BackgroundTransparency = SECTION_BG_TRANSPARENCY
    s.BorderSizePixel = 0
    s.ZIndex = 3
    s.AutomaticSize = Enum.AutomaticSize.Y
    if side == "full" then
        s.Position = UDim2.new(0, PAD, 0, SECTION_Y)
        s.Size = UDim2.new(1, -PAD * 2, 0, 0)
    else
        if side == 0 then
            s.Position = UDim2.new(0, PAD, 0, SECTION_Y)
        else
            s.Position = UDim2.new(0.5, PAD * 0.5, 0, SECTION_Y)
        end
        s.Size = UDim2.new(0.5, -PAD * 1.5, 0, 0)
    end
    doubleStroke(s)
    track("Main", s, "BackgroundColor3")
    local line = Instance.new("Frame")
    line.Name = "SectionLine"
    line.Parent = s
    line.BackgroundColor3 = Palette.Accent
    line.BorderSizePixel = 0
    line.Position = UDim2.new(0, 1, 0, 1)
    line.Size = UDim2.new(1, -2, 0, 1)
    line.ZIndex = 8
    line.Active = false
    line.Interactable = false
    track("Accent", line, "BackgroundColor3")
    local grad = Instance.new("UIGradient")
    grad.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0.00, 0.00),
        NumberSequenceKeypoint.new(0.00, 0.99),
        NumberSequenceKeypoint.new(0.50, 0.02),
        NumberSequenceKeypoint.new(1.00, 0.98),
        NumberSequenceKeypoint.new(1.00, 0.00),
    }
    grad.Parent = line
    local nameLbl = label(s, name, 14, Palette.Text, Enum.TextXAlignment.Center)
    nameLbl.Position = UDim2.new(0, 0, 0, 0)
    nameLbl.Size = UDim2.new(1, 0, 0, HEADER_H)
    nameLbl.ZIndex = 7
    track("Text", nameLbl, "TextColor3")
    local body = Instance.new("Frame")
    body.Parent = s
    body.BackgroundTransparency = 1
    body.BorderSizePixel = 0
    body.Position = UDim2.new(0, PAD, 0, HEADER_H)
    body.Size = UDim2.new(1, -PAD * 2, 0, PAD)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.ZIndex = 6
    body.Active = true
    body.Interactable = true
    local list = Instance.new("UIListLayout")
    list.Parent = body
    list.Padding = UDim.new(0, gapOverride)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.HorizontalAlignment = Enum.HorizontalAlignment.Center
    list.VerticalAlignment = Enum.VerticalAlignment.Top
    local pad = Instance.new("UIPadding")
    pad.Parent = body
    pad.PaddingBottom = UDim.new(0, PAD)
    local self2 = setmetatable({ Frame = s, Body = body, Layout = list }, Section)
    return self2
end

local Window = {}
Window.__index = Window

function Window:Tab(data)
    local name = data.Name or "Tab"
    local tab = Instance.new("TextButton")
    tab.Parent = self.Title
    tab.BackgroundTransparency = 1
    tab.BorderSizePixel = 0
    tab.AnchorPoint = Vector2.new(1, 0.5)
    local index = #self.Tabs + 1
    local offsetFromRight = TAB_RIGHT + (1 - index) * (TAB_W + TAB_GAP)
    tab.Position = UDim2.new(1, -offsetFromRight, 0.5, 0)
    tab.Size = UDim2.new(0, TAB_W, 0, BAR_H - 8)
    tab.FontFace = Fonts.Gotham
    tab.Text = name
    tab.TextColor3 = index == 1 and Palette.Text or Palette.TextDim
    tab.TextSize = 14
    tab.TextXAlignment = Enum.TextXAlignment.Right
    tab.TextYAlignment = Enum.TextYAlignment.Center
    tab.AutoButtonColor = false
    tab.ZIndex = 20
    tab.Active = true
    tab.Interactable = true
    track(index == 1 and "Text" or "TextDim", tab, "TextColor3")
    table.insert(self.TabButtons, tab)
    local page = Instance.new("ScrollingFrame")
    page.Parent = self.Content
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Position = UDim2.new(0, 0, 0, 0)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.ZIndex = 3
    page.Visible = (index == 1)
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Palette.Accent
    page.ScrollBarImageTransparency = 0.3
    page.Active = true
    track("Accent", page, "ScrollBarImageColor3")
    table.insert(self.Pages, page)
    tab.MouseButton1Click:Connect(function()
        for j = 1, #self.Tabs do
            local on = (j == index)
            untrack(self.TabButtons[j])
            track(on and "Text" or "TextDim", self.TabButtons[j], "TextColor3")
            self.TabButtons[j].TextColor3 = on and Palette.Text or Palette.TextDim
            self.Pages[j].Visible = on
        end
    end)
    table.insert(self.Tabs, name)
    local self2 = setmetatable({ Page = page, Window = self }, Tab)
    return self2
end

local Library = {}
Library.__index = Library

function Library:Window(data)
    local windowName = data.Name or "Howl"
    local windowSize = data.Size or UDim2.new(0, WINDOW_W, 0, WINDOW_H)

    local Menu = Instance.new("ScreenGui")
    Menu.Name = "menu"
    Menu.Parent = GuiParent
    Menu.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    Menu.ResetOnSpawn = false
    Menu.IgnoreGuiInset = true

    local Home = Instance.new("Frame")
    Home.Name = "menu"
    Home.Parent = Menu
    Home.BackgroundColor3 = Palette.Main
    Home.BackgroundTransparency = PANEL_BG_TRANSPARENCY
    Home.BorderSizePixel = 0
    Home.Position = UDim2.new(0.224508047, 0, 0.115942031, 0)
    Home.Size = windowSize
    Home.ZIndex = 1
    Home.ClipsDescendants = false
    Home.Visible = true
    track("Main", Home, "BackgroundColor3")

    local homeOuter = stroke(Home, Palette.Outline, 1)
    track("Outline", homeOuter, "Color")

    local homeInnerContainer = Instance.new("Frame")
    homeInnerContainer.Parent = Home
    homeInnerContainer.BackgroundTransparency = 1
    homeInnerContainer.BorderSizePixel = 0
    homeInnerContainer.Position = UDim2.new(0, 1, 0, 1)
    homeInnerContainer.Size = UDim2.new(1, -2, 1, -2)
    homeInnerContainer.ZIndex = 2
    homeInnerContainer.Active = false
    homeInnerContainer.Interactable = false
    local homeInner = stroke(homeInnerContainer, Palette.Inline, 1)
    track("Inline", homeInner, "Color")

    fadeHome = Home
    local menuOpen = true
    local function setHomeVisible(v)
        if v then
            Home.Visible = true
            forceHideAll()
            fadeState = 0
            fadeTo(1, 0.32, Enum.EasingStyle.Quart, false)
        else
            fadeTo(0, 0.32, Enum.EasingStyle.Quart, true)
        end
    end
    local function toggleMenu()
        menuOpen = not menuOpen
        setHomeVisible(menuOpen)
    end

    local Title = Instance.new("Frame")
    Title.Parent = Home
    Title.BackgroundColor3 = Palette.Main
    Title.BackgroundTransparency = SECTION_BG_TRANSPARENCY
    Title.BorderSizePixel = 0
    Title.Position = UDim2.new(0, 1, 0, 1)
    Title.Size = UDim2.new(1, -2, 0, BAR_H)
    Title.ZIndex = 3
    track("Main", Title, "BackgroundColor3")

    local TitleLine = Instance.new("Frame")
    TitleLine.Name = "TitleLine"
    TitleLine.Parent = Title
    TitleLine.BackgroundColor3 = Palette.Inline
    TitleLine.BorderSizePixel = 0
    TitleLine.Position = UDim2.new(0, 0, 1, -1)
    TitleLine.Size = UDim2.new(1, 0, 0, 1)
    TitleLine.ZIndex = 8
    TitleLine.Active = false
    TitleLine.Interactable = false
    track("Inline", TitleLine, "BackgroundColor3")

    local howlLbl = Instance.new("TextLabel")
    howlLbl.Parent = Title
    howlLbl.BackgroundTransparency = 1
    howlLbl.BorderSizePixel = 0
    howlLbl.FontFace = Fonts.Gotham
    howlLbl.Text = windowName
    howlLbl.TextColor3 = Palette.Text
    howlLbl.TextSize = 14
    howlLbl.TextXAlignment = Enum.TextXAlignment.Left
    howlLbl.TextYAlignment = Enum.TextYAlignment.Center
    howlLbl.AutomaticSize = Enum.AutomaticSize.X
    howlLbl.Size = UDim2.new(0, 0, 1, 0)
    howlLbl.Position = UDim2.new(0, LEFT_GAP, 0, 0)
    howlLbl.ZIndex = 6
    howlLbl.Active = false
    howlLbl.Interactable = false
    track("Text", howlLbl, "TextColor3")

    local ccLbl = Instance.new("TextLabel")
    ccLbl.Parent = Title
    ccLbl.BackgroundTransparency = 1
    ccLbl.BorderSizePixel = 0
    ccLbl.FontFace = Fonts.Gotham
    ccLbl.Text = ".cc"
    ccLbl.TextColor3 = Palette.Accent
    ccLbl.TextSize = 14
    ccLbl.TextXAlignment = Enum.TextXAlignment.Left
    ccLbl.TextYAlignment = Enum.TextYAlignment.Center
    ccLbl.AutomaticSize = Enum.AutomaticSize.X
    ccLbl.Size = UDim2.new(0, 0, 1, 0)
    ccLbl.Position = UDim2.new(0, LEFT_GAP, 0, 0)
    ccLbl.ZIndex = 6
    ccLbl.Active = false
    ccLbl.Interactable = false
    track("Accent", ccLbl, "TextColor3")

    local function positionCC()
        local w = howlLbl.AbsoluteSize.X
        if w and w > 0 then
            ccLbl.Position = UDim2.new(0, LEFT_GAP + w, 0, 0)
        end
    end
    howlLbl:GetPropertyChangedSignal("AbsoluteSize"):Connect(positionCC)
    task.defer(positionCC)
    task.delay(0.1, positionCC)

    local dragArea = Instance.new("TextButton")
    dragArea.Parent = Title
    dragArea.BackgroundTransparency = 1
    dragArea.BorderSizePixel = 0
    dragArea.Text = ""
    dragArea.AutoButtonColor = false
    dragArea.Modal = false
    dragArea.Size = UDim2.new(1, 0, 1, 0)
    dragArea.Position = UDim2.new(0, 0, 0, 0)
    dragArea.ZIndex = 5
    dragArea.Active = true
    dragArea.Interactable = true

    local contentY = 1 + BAR_H + 1 + GAP
    local contentH = windowSize.Y.Offset - contentY - GAP

    local Content = Instance.new("Frame")
    Content.Parent = Home
    Content.BackgroundTransparency = 1
    Content.BorderSizePixel = 0
    Content.Position = UDim2.new(0, 1, 0, contentY)
    Content.Size = UDim2.new(1, -2, 0, contentH)
    Content.ZIndex = 2

    do
        local dragging = false
        local dragStart = Vector2.new(0, 0)
        local startPos = UDim2.new(0, 0, 0, 0)
        dragArea.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = Vector2.new(input.Position.X, input.Position.Y)
                startPos = Home.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                local dx = input.Position.X - dragStart.X
                local dy = input.Position.Y - dragStart.Y
                Home.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + dx,
                    startPos.Y.Scale, startPos.Y.Offset + dy
                )
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local self = setmetatable({
        Gui = Menu,
        Home = Home,
        Title = Title,
        Content = Content,
        Tabs = {},
        Pages = {},
        TabButtons = {},
        Toggle = toggleMenu,
        SetVisible = setHomeVisible,
        Palette = Palette,
        SetTheme = applyRole,
        SaveConfig = saveConfigFile,
        LoadConfig = loadConfigFile,
        DeleteConfig = deleteConfigFile,
        ListConfigs = listConfigs,
        SetMenuKey = function(k) end,
    }, Window)
    return self
end

return Library
