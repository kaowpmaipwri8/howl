local function ensureGlobalClick()
    if globalClickConn then return end
    globalClickConn = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local pos = input.Position
        for dd in pairs(allDropdowns) do
            if dd.opened then
                local function inside(g)
                    if not g or not g.Parent then return false end
                    local a, s = g.AbsolutePosition, g.AbsoluteSize
                    return pos.X >= a.X and pos.X <= a.X + s.X
                       and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
                end
                if not (inside(dd.field) or inside(dd.list)) then
                    dd:setOpen(false)
                end
            end
        end
    end)
