local function autoToggle(sec, name, default, cb)
    local state = default or false
    local row = Instance.new("TextButton")
    row.Parent = sec.Body
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, 0, 0, ROW_H)
    row.Text = ""
    row.AutoButtonColor = false
    row.ZIndex = 6
    row.LayoutOrder = #sec.Body:GetChildren()
    row.Active = true
    row.Interactable = true
    local box = Instance.new("Frame")
    box.Parent = row
    box.BackgroundColor3 = state and Palette.Accent or Palette.Main
    box.BackgroundTransparency = 0
    box.BorderSizePixel = 0
    box.AnchorPoint = Vector2.new(0, 0.5)
    box.Position = UDim2.new(0, 0, 0.5, 0)
    box.Size = UDim2.new(0, 14, 0, 14)
    box.ZIndex = 7
    box.Active = false
    box.Interactable = false
    doubleStroke(box)
    track(state and "Accent" or "Main", box, "BackgroundColor3")
    local lbl = label(row, name, 14, Palette.Text, Enum.TextXAlignment.Left)
    lbl.Position = UDim2.new(0, 22, 0, 0)
    lbl.Size = UDim2.new(1, -22, 1, 0)
    lbl.ZIndex = 8
    lbl.Active = false
    lbl.Interactable = false
    track("Text", lbl, "TextColor3")
    local function set(v, silent)
