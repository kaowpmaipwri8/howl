            Callback = function(v)
                if v == "Default" then
                    applyRole("Main",    Color3.fromRGB(0x19, 0x19, 0x19))
                    applyRole("Inline",  Color3.fromRGB(0x4B, 0x4B, 0x4B))
                    applyRole("Outline", Color3.fromRGB(0x00, 0x00, 0x00))
                    applyRole("Accent",  Color3.fromRGB(0xFF, 0xE2, 0x03))
                    applyRole("Text",    Color3.fromRGB(0xFF, 0xFF, 0xFF))
                    applyRole("TextDim", Color3.fromRGB(0x56, 0x56, 0x56))
                elseif v == "Cherry" then
                    applyRole("Main",    Color3.fromRGB(0x1A, 0x0A, 0x0F))
                    applyRole("Inline",  Color3.fromRGB(0x6B, 0x1F, 0x2E))
                    applyRole("Outline", Color3.fromRGB(0x00, 0x00, 0x00))
                    applyRole("Accent",  Color3.fromRGB(0xFF, 0x4F, 0x6A))
                    applyRole("Text",    Color3.fromRGB(0xFF, 0xFF, 0xFF))
                    applyRole("TextDim", Color3.fromRGB(0xB5, 0x6A, 0x7A))
                elseif v == "Galaxy" then
                    applyRole("Main",    Color3.fromRGB(0x0B, 0x0A, 0x1A))
                    applyRole("Inline",  Color3.fromRGB(0x2A, 0x25, 0x55))
                    applyRole("Outline", Color3.fromRGB(0x00, 0x00, 0x00))
                    applyRole("Accent",  Color3.fromRGB(0x9C, 0x7B, 0xFF))
                    applyRole("Text",    Color3.fromRGB(0xFF, 0xFF, 0xFF))
                    applyRole("TextDim", Color3.fromRGB(0x7A, 0x72, 0xB5))
                elseif v == "Red" then
                    applyRole("Main",    Color3.fromRGB(0x1A, 0x0A, 0x0A))
                    applyRole("Inline",  Color3.fromRGB(0x5A, 0x12, 0x12))
                    applyRole("Outline", Color3.fromRGB(0x00, 0x00, 0x00))
                    applyRole("Accent",  Color3.fromRGB(0xFF, 0x2C, 0x2C))
                    applyRole("Text",    Color3.fromRGB(0xFF, 0xFF, 0xFF))
                    applyRole("TextDim", Color3.fromRGB(0xB5, 0x66, 0x66))
                elseif v == "Sakura" then
                    applyRole("Main",    Color3.fromRGB(0x1F, 0x14, 0x1A))
                    applyRole("Inline",  Color3.fromRGB(0x8A, 0x4A, 0x6B))
                    applyRole("Outline", Color3.fromRGB(0x00, 0x00, 0x00))
                    applyRole("Accent",  Color3.fromRGB(0xFF, 0xB7, 0xD5))
                    applyRole("Text",    Color3.fromRGB(0xFF, 0xFF, 0xFF))
                    applyRole("TextDim", Color3.fromRGB(0xC9, 0x9E, 0xB5))
                end
            end,
        })

        if presetDropdown and presetDropdown.Row then
            local r = presetDropdown.Row
            local field = r:FindFirstChildOfClass("TextButton")
            if field then
                field.AnchorPoint = Vector2.new(1, 0.5)
                field.Position = UDim2.new(1, 0, 0.5, 0)
                field.Size = UDim2.new(0.72, 0, 0, 22)
                field.Parent = presetRow
            end
            r:Destroy()
        end

        local themes = {
            { "Accent",     "Accent"  },
            { "Background", "Main"    },
            { "Inline",     "Inline"  },
            { "Outline",    "Outline" },
            { "Text",       "Text"    },
            { "Text Dim",   "TextDim" },
        }
        for _, pair in ipairs(themes) do
            local displayName, role = pair[1], pair[2]
            ThemeSection:Colorpicker({
                Name = displayName,
                Default = Palette[role],
                Callback = function(c)
                    applyRole(role, c)
                end,
            })
        end
    end

    return self
end

return Library
