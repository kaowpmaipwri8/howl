    hexBox.FocusLost:Connect(function()
        local hx = hexBox.Text:gsub("#", ""):gsub(" ", "")
        if #hx == 6 then
            local ok, c = pcall(function() return Color3.fromHex(hx) end)
            if ok and c then
                color = c
                h, s, v = color:ToHSV()
                update(false)
                return
            end
        end
        update(true)
    end)
    local function closeOnClickOutside(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if not cp.opened then return end
        local pos = input.Position
        local function inside(g)
            if not g or not g.Parent then return false end
            local a, sz = g.AbsolutePosition, g.AbsoluteSize
            return pos.X >= a.X and pos.X <= a.X + sz.X
               and pos.Y >= a.Y and pos.Y <= a.Y + sz.Y
        end
        if not (inside(swatch) or inside(popup)) then
            cp:setOpen(false)
        end
    end
    UserInputService.InputBegan:Connect(closeOnClickOutside)
    update(true)
    local api = {
        Set = function(c)
            color = c
            h, s, v = color:ToHSV()
            update()
        end,
        Get = function() return color end,
    }
    if flag then registerConfigElement(flag, api.Get, api.Set, "colorpicker") end
    return api
end

local function makeLabel(body, data)
    local text = data.Name or data.Text or "Label"
    local l = Instance.new("TextLabel")
    l.Parent = body
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.FontFace = Fonts.Gotham
    l.Text = text
    l.TextColor3 = Palette.Text
    l.TextSize = 13
    l.TextXAlignment = Enum.TextXAlignment.Center
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.TextWrapped = true
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.Size = UDim2.new(1, 0, 0, 0)
    l.ZIndex = 6
    l.LayoutOrder = #body:GetChildren()
    track("Text", l, "TextColor3")
    return {
        Set = function(t) l.Text = t end,
        Get = function() return l.Text end,
    }
end

