    if listBorder.oL then track("Outline", listBorder.oL, "BackgroundColor3") end
    if listBorder.oR then track("Outline", listBorder.oR, "BackgroundColor3") end
    if listBorder.oB then track("Outline", listBorder.oB, "BackgroundColor3") end
    if listBorder.iL then track("Inline", listBorder.iL, "BackgroundColor3") end
    if listBorder.iR then track("Inline", listBorder.iR, "BackgroundColor3") end
    if listBorder.iB then track("Inline", listBorder.iB, "BackgroundColor3") end
    local optionsHolder = Instance.new("Frame")
    optionsHolder.Parent = list
    optionsHolder.BackgroundTransparency = 1
    optionsHolder.BorderSizePixel = 0
    optionsHolder.Position = UDim2.new(0, 0, 0, 0)
    optionsHolder.Size = UDim2.new(1, 0, 1, 0)
    optionsHolder.ZIndex = 503
    optionsHolder.Active = true
    optionsHolder.Interactable = true
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, DROPDOWN_LIST_PAD)
    pad.PaddingBottom = UDim.new(0, DROPDOWN_LIST_PAD)
    pad.Parent = optionsHolder
    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 0)
    listLayout.Parent = optionsHolder
    local function paintOptions()
        for optName, d in pairs(optionButtons) do
            untrack(d.label)
            if optName == value then
                d.label.TextColor3 = Palette.Accent
                track("Accent", d.label, "TextColor3")
            else
                d.label.TextColor3 = Palette.Text
                track("Text", d.label, "TextColor3")
            end
        end
    end
    local function selectOption(optName, silent)
        optName = tostring(optName)
        if not seen[optName] then return end
        value = optName
        fieldText.Text = optName
        paintOptions()
        if not silent and cb then cb(value) end
    end
    local function addOption(optName, order)
        local btn = Instance.new("TextButton")
        btn.Parent = optionsHolder
        btn.Size = UDim2.new(1, 0, 0, DROPDOWN_ITEM_H)
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.Text = ""
        btn.LayoutOrder = order
        btn.ZIndex = 504
        btn.Active = true
        btn.Interactable = true
        local optText = Instance.new("TextLabel")
        optText.Parent = btn
        optText.BackgroundTransparency = 1
        optText.BorderSizePixel = 0
        optText.Position = UDim2.new(0, 0, 0, 0)
        optText.Size = UDim2.new(1, 0, 1, 0)
        optText.FontFace = Fonts.Gotham
        optText.TextSize = 13
        optText.Text = tostring(optName)
        optText.TextColor3 = (tostring(optName) == value) and Palette.Accent or Palette.Text
        optText.TextXAlignment = Enum.TextXAlignment.Center
        optText.TextYAlignment = Enum.TextYAlignment.Center
        optText.ZIndex = 505
        optText.Active = false
        optText.Interactable = false
        applyTextNudge(optText)
        track("Text", optText, "TextColor3")
        btn.MouseEnter:Connect(function()
            btn.BackgroundColor3 = Palette.Inline
            btn.BackgroundTransparency = 0
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundTransparency = 1
        end)
        btn.MouseButton1Click:Connect(function()
            selectOption(optName)
            lastToggle = os.clock() + 0.2
            dd:setOpen(false)
        end)
        optionButtons[tostring(optName)] = { btn = btn, label = optText }
    end
    for i, opt in ipairs(items) do
        addOption(opt, i)
    end
    local dd = { opened = false, field = field, list = list }
    local function positionList()
        local homeAbs = fadeHome.AbsolutePosition
        local fAbs = field.AbsolutePosition
        local fSize = field.AbsoluteSize
        local lx = fAbs.X - homeAbs.X
        local ly = fAbs.Y - homeAbs.Y + fSize.Y
        list.Position = UDim2.fromOffset(lx, ly)
        list.Size = UDim2.new(0, fSize.X, 0, listH)
    end
    function dd:setOpen(o)
        if self.opened == o then return end
        if o then
            positionList()
            list.Visible = true
            if fieldBorder.oB then fieldBorder.oB.Visible = false end
            if fieldBorder.iB then fieldBorder.iB.Visible = false end
            tween(chevron, { Rotation = 180 }, 0.15)
        else
            list.Visible = false
            if fieldBorder.oB then fieldBorder.oB.Visible = true end
            if fieldBorder.iB then fieldBorder.iB.Visible = true end
            tween(chevron, { Rotation = 0 }, 0.15)
        end
        self.opened = o
    end
    field.MouseButton1Click:Connect(function()
        local now = os.clock()
        if now < lastToggle then return end
        lastToggle = now
        dd:setOpen(not dd.opened)
    end)
    local api = {
        Set = function(v) selectOption(v) end,
        Get = function() return value end,
        Row = row,
    }
    if flag then registerConfigElement(flag, api.Get, api.Set, "dropdown") end
    return api
end

local function makeColorpicker(body, data)
    local name = data.Name or "Color"
