-- ============================================================
-- THEME TRACKING
-- ============================================================
local themeMap = {
    Main    = {},
    Inline  = {},
    Accent  = {},
    Text    = {},
    TextDim = {},
    Outline = {},
}
local function track(role, obj, prop)
    if not themeMap[role] then themeMap[role] = {} end
    table.insert(themeMap[role], { obj = obj, prop = prop })
end
local function untrack(obj)
    for _, list in pairs(themeMap) do
        for i = #list, 1, -1 do
            if list[i].obj == obj then
                table.remove(list, i)
            end
        end
    end
end

local configRegistry = {}
local function registerConfigElement(name, getter, setter, kind)
    table.insert(configRegistry, { Name = name, Get = getter, Set = setter, Kind = kind })
end

local function applyRole(role, c)
    Palette[role] = c
    local list = themeMap[role]
    if not list then return end
    for _, t in ipairs(list) do
        if t.obj and t.obj.Parent then
            pcall(function() t.obj[t.prop] = c end)
        end
    end
end

-- ============================================================
-- FADE SYSTEM
-- ============================================================
local fadeCache = nil
local fadeConn = nil
local fadeState = 1
local fadeHome = nil

local function collectFadeTargets()
    if not fadeHome then return end
    fadeCache = {}
    for _, d in ipairs(fadeHome:GetDescendants()) do
        if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("TextBox")
           or d:IsA("ScrollingFrame") then
            table.insert(fadeCache, { obj = d, prop = "BackgroundTransparency" })
        end
        if d:IsA("TextButton") or d:IsA("TextBox") or d:IsA("TextLabel") then
            table.insert(fadeCache, { obj = d, prop = "TextTransparency" })
        end
        if d:IsA("ImageLabel") then
            table.insert(fadeCache, { obj = d, prop = "ImageTransparency" })
        end
        if d:IsA("UIStroke") then
            table.insert(fadeCache, { obj = d, prop = "Transparency" })
        end
    end
end

local function snapshotBases()
    if not fadeCache then return end
    for _, t in ipairs(fadeCache) do
        t.base = t.obj[t.prop]
    end
end

local function applyFade(alpha)
    if not fadeCache then return end
    for _, t in ipairs(fadeCache) do
        if t.obj and t.obj.Parent then
            local base = t.base or 0
            local v = 1 - (1 - base) * alpha
            if v < 0 then v = 0 elseif v > 1 then v = 1 end
            pcall(function() t.obj[t.prop] = v end)
        end
    end
end

local function forceHideAll()
    if not fadeHome then return end
    for _, d in ipairs(fadeHome:GetDescendants()) do
        if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("TextBox")
           or d:IsA("ScrollingFrame") then
            pcall(function() d.BackgroundTransparency = 1 end)
        end
        if d:IsA("TextButton") or d:IsA("TextBox") or d:IsA("TextLabel") then
            pcall(function() d.TextTransparency = 1 end)
        end
        if d:IsA("ImageLabel") then
            pcall(function() d.ImageTransparency = 1 end)
        end
        if d:IsA("UIStroke") then
            pcall(function() d.Transparency = 1 end)
        end
    end
end

local function fadeTo(target, duration, style, hideWhenDone)
    if not fadeHome then return end
    if fadeConn then fadeConn:Disconnect() fadeConn = nil end
    local startA = fadeState
    local t0 = os.clock()
    if duration <= 0 then
        fadeState = target
        if target <= 0 then
            forceHideAll()
            if hideWhenDone then fadeHome.Visible = false end
        else
            applyFade(target)
        end
        return
    end
    fadeConn = RunService.RenderStepped:Connect(function()
        local a = math.clamp((os.clock() - t0) / duration, 0, 1)
        if style == Enum.EasingStyle.Cubic then
            a = 1 - (1 - a) ^ 3
        elseif style == Enum.EasingStyle.Quart then
            a = 1 - (1 - a) ^ 4
        elseif style == Enum.EasingStyle.Sine then
            a = math.sin(a * math.pi / 2)
        else
            a = 1 - (1 - a) * (1 - a)
        end
        fadeState = startA + (target - startA) * a
        applyFade(fadeState)
        if a >= 1 then
            fadeState = target
            if target <= 0 then
                forceHideAll()
            else
                applyFade(target)
            end
            fadeConn:Disconnect()
            fadeConn = nil
            if hideWhenDone and target <= 0 then
                fadeHome.Visible = false
            end
        end
    end)
end

-- ============================================================
-- CONFIG SYSTEM
-- ============================================================
local ConfigDir = "Howl/Configs"

local function listConfigs()
    local ok, files = pcall(listfiles, ConfigDir)
    if not ok or not files then return {} end
    local out = {}
    for _, path in ipairs(files) do
        local nm = path:match("([^/\\]+)%.json$")
        if nm then table.insert(out, nm) end
    end
    table.sort(out)
    return out
end

local function encodeValue(v)
    if typeof(v) == "Color3" then
        return { __type = "Color3", R = v.R, G = v.G, B = v.B }
    elseif typeof(v) == "EnumItem" then
        return { __type = "EnumItem", value = tostring(v) }
    elseif type(v) == "table" then
        local out = {}
        for k, vv in pairs(v) do out[k] = encodeValue(vv) end
        return out
    end
    return v
end

local function decodeValue(v)
    if type(v) == "table" then
        if v.__type == "Color3" then
            return Color3.new(v.R, v.G, v.B)
        elseif v.__type == "EnumItem" then
            local enumName, enumItem = v.value:match("Enum%.([%w_]+)%.([%w_]+)")
            if enumName and enumItem and Enum[enumName] then
                return Enum[enumName][enumItem]
            end
            return nil
        end
        local out = {}
        for k, vv in pairs(v) do out[k] = decodeValue(vv) end
        return out
    end
    return v
end

local function buildConfigData()
    local data = {}
    for _, entry in ipairs(configRegistry) do
        local ok, val = pcall(entry.Get)
        if ok then
            data[entry.Name] = encodeValue(val)
        end
    end
    return data
end

local function applyConfigData(data)
    for _, entry in ipairs(configRegistry) do
        if data[entry.Name] ~= nil then
            local decoded = decodeValue(data[entry.Name])
            pcall(entry.Set, decoded)
        end
    end
end

local function saveConfigFile(name)
    if not name or name == "" then return false, "empty name" end
    local path = ConfigDir .. "/" .. name .. ".json"
    local ok, err = pcall(function()
        writefile(path, HttpService:JSONEncode(buildConfigData()))
    end)
    return ok, err
end

local function loadConfigFile(name)
    if not name or name == "" then return false, "empty name" end
    local path = ConfigDir .. "/" .. name .. ".json"
    if not isfile(path) then return false, "not found" end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not ok or type(decoded) ~= "table" then return false, "invalid" end
    applyConfigData(decoded)
    return true
end

local function deleteConfigFile(name)
    if not name or name == "" then return false, "empty name" end
    local path = ConfigDir .. "/" .. name .. ".json"
    if not isfile(path) then return false, "not found" end
    local ok, err = pcall(delfile, path)
    return ok, err
end

