local Section = {}
Section.__index = Section
function Section:Toggle(d) return makeToggle(self.Body, d) end
function Section:Slider(d) return makeSlider(self.Body, d) end
function Section:Keybind(d) return makeKeybind(self.Body, d) end
function Section:Dropdown(d) return makeDropdown(self.Body, d) end
function Section:Colorpicker(d) return makeColorpicker(self.Body, d) end
function Section:ColorPicker(d) return makeColorpicker(self.Body, d) end
function Section:Label(d) return makeLabel(self.Body, d) end
function Section:Button(d) return makeButton(self.Body, d) end
function Section:Textbox(d) return makeTextbox(self.Body, d) end
function Section:Listbox(d) return makeListbox(self.Body, d) end

local Tab = {}
Tab.__index = Tab

function Tab:Section(data)
    local name = data.Name or "Section"
    local side = data.Side or 0
    local gapOverride = data.Gap or GAP

    local s = Instance.new("Frame")
    s.Parent = self.Page
    s.BackgroundColor3 = Palette.Main
    s.BackgroundTransparency = SECTION_BG_TRANSPARENCY
    s.BorderSizePixel = 0
    s.ZIndex = Z.Panel
    s.AutomaticSize = Enum.AutomaticSize.Y
    if side == "full" then
        s.Position = UDim2.new(0, PAD, 0, SECTION_Y)
        s.Size = UDim2.new(1, -PAD * 2, 0, 0)
    elseif side == 0 then
        s.Position = UDim2.new(0, PAD, 0, SECTION_Y)
        s.Size = UDim2.new(0.5, -PAD * 1.5, 0, 0)
    else
        s.Position = UDim2.new(0.5, PAD * 0.5, 0, SECTION_Y)
        s.Size = UDim2.new(0.5, -PAD * 1.5, 0, 0)
    end
    doubleStroke(s)
    track("Main", s, "BackgroundColor3")

    local line = Instance.new("Frame")
    line.Parent = s
    line.BackgroundColor3 = Palette.Accent
    line.BorderSizePixel = 0
    line.Position = UDim2.new(0, 1, 0, 1)
    line.Size = UDim2.new(1, -2, 0, 1)
    line.ZIndex = Z.SectionLine
    track("Accent", line, "BackgroundColor3")
    local grad = Instance.new("UIGradient")
    grad.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0.00, 0.00),
        NumberSequenceKeypoint.new(0.00, 0.99),
        NumberSequenceKeypoint.new(0.50, 0.02),
        NumberSequenceKeypoint.new(1.00, 0.98),
        NumberSequenceKeypoint.new(1.00, 0.00),
    }
    grad.Parent = line

    local nameLbl = label(s, name, 14, Palette.Text, Enum.TextXAlignment.Center, Z.SectionLabel)
    nameLbl.Size = UDim2.new(1, 0, 0, HEADER_H)
    track("Text", nameLbl, "TextColor3")

    local body = Instance.new("Frame")
    body.Parent = s
    body.BackgroundTransparency = 1
    body.Position = UDim2.new(0, PAD, 0, HEADER_H)
    body.Size = UDim2.new(1, -PAD * 2, 0, PAD)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.ZIndex = Z.Panel + 1

    local list = Instance.new("UIListLayout")
    list.Parent = body
    list.Padding = UDim.new(0, gapOverride)
    list.SortOrder = Enum.SortOrder.LayoutOrder

    local pad = Instance.new("UIPadding")
    pad.Parent = body
    pad.PaddingBottom = UDim.new(0, PAD)

    return setmetatable({ Frame = s, Body = body, Layout = list }, Section)
end

local Window = {}
Window.__index = Window

function Window:Tab(data)
    local name = data.Name or "Tab"
    local myIndex = #self.Tabs + 1

    -- Tab: TextButton with measured, fixed width so hitbox = visible box.
    local tab = Instance.new("TextButton")
    tab.Parent = self.TabsContainer
    tab.BackgroundTransparency = 1
    tab.BorderSizePixel = 0
    tab.FontFace = Fonts.Gotham
    tab.Text = name
    tab.TextColor3 = (myIndex == 1) and Palette.Text or Palette.TextDim
    tab.TextSize = 14
    tab.TextXAlignment = Enum.TextXAlignment.Center
    tab.TextYAlignment = Enum.TextYAlignment.Center
    tab.AutoButtonColor = false
    tab.ZIndex = Z.Tab
    tab.LayoutOrder = myIndex
    tab.TextWrapped = false
    tab.Size = UDim2.new(0, 40, 0, TAB_H)   -- placeholder; resized below

    -- Measure text width using TextService
    local measured = game:GetService("TextService"):GetTextSize(
        name, 14, Fonts.Gotham, Vector2.new(1000, TAB_H)
    )
    tab.Size = UDim2.fromOffset(measured.X + TAB_PAD_X * 2, TAB_H)

    track((myIndex == 1) and "Text" or "TextDim", tab, "TextColor3")
    table.insert(self.TabButtons, tab)

    local page = Instance.new("ScrollingFrame")
    page.Parent = self.Content
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Size = UDim2.new(1, 0, 1, 0)
    page.ZIndex = Z.Background
    page.Visible = (myIndex == 1)
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Palette.Accent
    page.ScrollBarImageTransparency = 0.3
    page.ClipsDescendants = true
    track("Accent", page, "ScrollBarImageColor3")
    table.insert(self.Pages, page)

    tab.MouseButton1Click:Connect(function()
        for j = 1, #self.TabButtons do
            local on = (j == myIndex)
            untrack(self.TabButtons[j])
            track(on and "Text" or "TextDim", self.TabButtons[j], "TextColor3")
            self.TabButtons[j].TextColor3 = on and Palette.Text or Palette.TextDim
            self.Pages[j].Visible = on
        end
    end)

    table.insert(self.Tabs, name)
    return setmetatable({ Page = page, Window = self }, Tab)
end

local Library = {}
Library.__index = Library

function Library:Window(data)
    local windowName = data.Name or "Howl"
    local windowSize = data.Size or UDim2.new(0, WINDOW_W, 0, WINDOW_H)
    local withSettings = data.Settings ~= false

    local Menu = Instance.new("ScreenGui")
    Menu.Name = "menu"
    Menu.Parent = GuiParent
    Menu.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    Menu.ResetOnSpawn = false
    Menu.IgnoreGuiInset = true

    local Home = Instance.new("Frame")
    Home.Name = "menu"
    Home.Parent = Menu
    Home.BackgroundColor3 = Palette.Main
    Home.BackgroundTransparency = PANEL_BG_TRANSPARENCY
    Home.BorderSizePixel = 0
    Home.Position = UDim2.new(0.22, 0, 0.12, 0)
    Home.Size = windowSize
    Home.ZIndex = Z.Background
    Home.ClipsDescendants = false
    Home.Visible = true
    track("Main", Home, "BackgroundColor3")
    windowState.home = Home

    local homeOuter = stroke(Home, Palette.Outline, 1)
    track("Outline", homeOuter, "Color")

    local innerContainer = Instance.new("Frame")
    innerContainer.Parent = Home
    innerContainer.BackgroundTransparency = 1
    innerContainer.Position = UDim2.new(0, 1, 0, 1)
    innerContainer.Size = UDim2.new(1, -2, 1, -2)
    innerContainer.ZIndex = Z.Background + 1
    local innerStroke = stroke(innerContainer, Palette.Inline, 1)
    track("Inline", innerStroke, "Color")

    local menuOpen = true
    local function setHomeVisible(v)
        menuOpen = v
        Home.Visible = v
    end
    local function toggleMenu() setHomeVisible(not menuOpen) end

    -- ========================================================
    -- TITLE BAR — three non-overlapping zones
    --   [ label zone (drag) ][ tab zone (clicks) ]
    -- ========================================================
    local Title = Instance.new("Frame")
    Title.Parent = Home
    Title.BackgroundColor3 = Palette.Main
    Title.BorderSizePixel = 0
    Title.Position = UDim2.new(0, 1, 0, 1)
    Title.Size = UDim2.new(1, -2, 0, BAR_H)
    Title.ZIndex = Z.Panel
    track("Main", Title, "BackgroundColor3")

    local titleLine = Instance.new("Frame")
    titleLine.Parent = Title
    titleLine.BackgroundColor3 = Palette.Inline
    titleLine.BorderSizePixel = 0
    titleLine.Position = UDim2.new(0, 0, 1, -1)
    titleLine.Size = UDim2.new(1, 0, 0, 1)
    titleLine.ZIndex = Z.SectionLine
    track("Inline", titleLine, "BackgroundColor3")

    -- Drag zone: only the LEFT portion of the title, fixed width.
    -- Does not cover the tab zone at all.
    local dragArea = Instance.new("TextButton")
    dragArea.Parent = Title
    dragArea.BackgroundTransparency = 1
    dragArea.Text = ""
    dragArea.AutoButtonColor = false
    dragArea.BorderSizePixel = 0
    dragArea.Position = UDim2.new(0, 0, 0, 0)
    dragArea.Size = UDim2.new(0, TITLE_LEFT_W, 1, 0)
    dragArea.ZIndex = Z.DragStrip

    -- Labels sit inside the drag zone. They don't intercept input.
    local howlLbl = Instance.new("TextLabel")
    howlLbl.Parent = Title
    howlLbl.BackgroundTransparency = 1
    howlLbl.FontFace = Fonts.Gotham
    howlLbl.Text = windowName
    howlLbl.TextColor3 = Palette.Text
    howlLbl.TextSize = 14
    howlLbl.TextXAlignment = Enum.TextXAlignment.Left
    howlLbl.TextYAlignment = Enum.TextYAlignment.Center
    howlLbl.Size = UDim2.new(0, TITLE_LEFT_W, 1, 0)
    howlLbl.Position = UDim2.new(0, LEFT_GAP, 0, 0)
    howlLbl.ZIndex = Z.TitleLabel
    howlLbl.Active = false
    howlLbl.Interactable = false
    track("Text", howlLbl, "TextColor3")

    local ccLbl = Instance.new("TextLabel")
    ccLbl.Parent = Title
    ccLbl.BackgroundTransparency = 1
    ccLbl.FontFace = Fonts.Gotham
    ccLbl.Text = ".cc"
    ccLbl.TextColor3 = Palette.Accent
    ccLbl.TextSize = 14
    ccLbl.TextXAlignment = Enum.TextXAlignment.Left
    ccLbl.TextYAlignment = Enum.TextYAlignment.Center
    ccLbl.Position = UDim2.new(0, LEFT_GAP, 0, 0)
    ccLbl.Size = UDim2.new(0, 60, 1, 0)
    ccLbl.ZIndex = Z.TitleLabel
    ccLbl.Active = false
    ccLbl.Interactable = false
    track("Accent", ccLbl, "TextColor3")

    -- Position .cc right after the title label
    local function positionCC()
        local w = howlLbl.TextBounds.X
        ccLbl.Position = UDim2.new(0, LEFT_GAP + w, 0, 0)
    end
    howlLbl:GetPropertyChangedSignal("TextBounds"):Connect(positionCC)
    positionCC()

    -- Tab zone: anchored to the right side of the title, doesn't touch the drag zone.
    local TabsContainer = Instance.new("Frame")
    TabsContainer.Parent = Title
    TabsContainer.BackgroundTransparency = 1
    TabsContainer.AnchorPoint = Vector2.new(1, 0.5)
    TabsContainer.Position = UDim2.new(1, -LEFT_GAP, 0.5, 0)
    TabsContainer.Size = UDim2.new(0, 0, 1, 0)
    TabsContainer.AutomaticSize = Enum.AutomaticSize.X
    TabsContainer.ZIndex = Z.Tab

    local tabsLayout = Instance.new("UIListLayout")
    tabsLayout.FillDirection = Enum.FillDirection.Horizontal
    tabsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    tabsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabsLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabsLayout.Padding = UDim.new(0, TAB_GAP)
    tabsLayout.Parent = TabsContainer

    -- Drag logic (only fires inside the left drag zone)
    do
        local dragging = false
        local dragStart, startPos
        dragArea.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = Vector2.new(input.Position.X, input.Position.Y)
                startPos = Home.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                local dx = input.Position.X - dragStart.X
                local dy = input.Position.Y - dragStart.Y
                Home.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + dx,
                    startPos.Y.Scale, startPos.Y.Offset + dy
                )
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    -- Content
    local contentY = 1 + BAR_H + 1 + GAP
    local contentH = windowSize.Y.Offset - contentY - GAP

    local Content = Instance.new("Frame")
    Content.Parent = Home
    Content.BackgroundTransparency = 1
    Content.Position = UDim2.new(0, 1, 0, contentY)
    Content.Size = UDim2.new(1, -2, 0, contentH)
    Content.ZIndex = Z.Background
    Content.ClipsDescendants = true

    local self = setmetatable({
        Gui = Menu,
        Home = Home,
        Title = Title,
        TabsContainer = TabsContainer,
        Content = Content,
        Tabs = {},
        Pages = {},
        TabButtons = {},
        Toggle = toggleMenu,
        SetVisible = setHomeVisible,
        Palette = Palette,
        SetTheme = applyRole,
        SaveConfig = saveConfigFile,
        LoadConfig = loadConfigFile,
        DeleteConfig = deleteConfigFile,
        ListConfigs = listConfigs,
    }, Window)

    -- Menu key
    local menuKey = Enum.KeyCode.RightShift
    local keyPicking = false
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp or keyPicking then return end
        if input.KeyCode == menuKey then toggleMenu() end
    end)

    if withSettings then
        local SettingsTab = self:Tab({ Name = "Settings" })
        local ConfigSection = SettingsTab:Section({ Name = "Config", Side = 0 })
        local ThemeSection  = SettingsTab:Section({ Name = "Theme",  Side = 1 })

        -- Config
        local nameState = ""
        local selectedConfig = nil
        local configList

        configList = ConfigSection:Listbox({
            Items = listConfigs(),
            Size = 120,
            Callback = function(v) selectedConfig = v end,
        })

        ConfigSection:Textbox({
            Name = "",
            Placeholder = "config name…",
            Callback = function(v) nameState = v end,
        })

        local btnRow = Instance.new("Frame")
        btnRow.Parent = ConfigSection.Body
        btnRow.BackgroundTransparency = 1
        btnRow.Size = UDim2.new(1, 0, 0, 26)
        btnRow.ZIndex = Z.ElementBg
        btnRow.LayoutOrder = #ConfigSection.Body:GetChildren()
        local btnLayout = Instance.new("UIListLayout")
        btnLayout.Parent = btnRow
        btnLayout.FillDirection = Enum.FillDirection.Horizontal
        btnLayout.Padding = UDim.new(0, 4)
        btnLayout.SortOrder = Enum.SortOrder.LayoutOrder
        btnLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        btnLayout.VerticalAlignment = Enum.VerticalAlignment.Center

        local function smallBtn(text, onClick)
            local b = Instance.new("TextButton")
            b.Parent = btnRow
            b.Size = UDim2.new(0.25, -3, 1, 0)
            b.BackgroundColor3 = Palette.Main
            b.BorderSizePixel = 0
            b.Text = ""
            b.AutoButtonColor = false
            b.LayoutOrder = #btnRow:GetChildren()
            b.ZIndex = Z.Hitbox
            doubleStroke(b)
            track("Main", b, "BackgroundColor3")
            local t = label(b, text, 12, Palette.Text, Enum.TextXAlignment.Center, Z.ElementText)
            t.Size = UDim2.new(1, 0, 1, 0)
            track("Text", t, "TextColor3")
            b.MouseEnter:Connect(function() b.BackgroundColor3 = Palette.Inline end)
            b.MouseLeave:Connect(function() b.BackgroundColor3 = Palette.Main end)
            b.MouseButton1Click:Connect(onClick)
            return b
        end

        smallBtn("Create", function()
            if nameState == "" then return end
            saveConfigFile(nameState)
            selectedConfig = nameState
            configList.Refresh(listConfigs(), nameState)
        end)
        smallBtn("Save", function()
            if not selectedConfig then return end
            saveConfigFile(selectedConfig)
        end)
        smallBtn("Load", function()
            if not selectedConfig then return end
            loadConfigFile(selectedConfig)
        end)
        smallBtn("Delete", function()
            if not selectedConfig then return end
            deleteConfigFile(selectedConfig)
            selectedConfig = nil
            configList.Refresh(listConfigs())
        end)

        -- Menu keybind row
        local menuRow = Instance.new("Frame")
        menuRow.Parent = ConfigSection.Body
        menuRow.BackgroundTransparency = 1
        menuRow.Size = UDim2.new(1, 0, 0, ROW_H)
        menuRow.ZIndex = Z.ElementBg
        menuRow.LayoutOrder = #ConfigSection.Body:GetChildren()

        local menuLbl = label(menuRow, "Menu:", 14, Palette.Text, Enum.TextXAlignment.Left, Z.ElementText)
        menuLbl.Size = UDim2.new(0.5, 0, 1, 0)
        track("Text", menuLbl, "TextColor3")

        local menuKeyBox = Instance.new("TextButton")
        menuKeyBox.Parent = menuRow
        menuKeyBox.AnchorPoint = Vector2.new(1, 0.5)
        menuKeyBox.Position = UDim2.new(1, 0, 0.5, 0)
        menuKeyBox.Size = UDim2.fromOffset(FIELD_W, FIELD_H)
        menuKeyBox.BackgroundTransparency = 1
        menuKeyBox.Text = ""
        menuKeyBox.AutoButtonColor = false
        menuKeyBox.ZIndex = Z.Hitbox

        local menuKeyText = Instance.new("TextLabel")
        menuKeyText.Parent = menuKeyBox
        menuKeyText.BackgroundTransparency = 1
        menuKeyText.FontFace = Fonts.Gotham
        menuKeyText.Text = menuKey.Name
        menuKeyText.TextColor3 = Palette.TextDim
        menuKeyText.TextSize = 10
        menuKeyText.TextXAlignment = Enum.TextXAlignment.Right
        menuKeyText.TextYAlignment = Enum.TextYAlignment.Center
        menuKeyText.Size = UDim2.new(1, 0, 1, 0)
        menuKeyText.ZIndex = Z.ElementText
        track("TextDim", menuKeyText, "TextColor3")

        menuKeyBox.MouseButton1Click:Connect(function()
            if keyPicking then return end
            keyPicking = true
            menuKeyText.Text = "..."
            menuKeyText.TextColor3 = Palette.Accent
            local conn
            conn = UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    menuKey = input.KeyCode
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                    menuKey = Enum.UserInputType.MouseButton1
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                    menuKey = Enum.UserInputType.MouseButton2
                else
                    return
                end
                keyPicking = false
                menuKeyText.Text = menuKey.Name
                menuKeyText.TextColor3 = Palette.TextDim
                conn:Disconnect()
            end)
        end)

        -- Themes
        local presetRow = Instance.new("Frame")
        presetRow.Parent = ThemeSection.Body
        presetRow.BackgroundTransparency = 1
        presetRow.Size = UDim2.new(1, 0, 0, 40)
        presetRow.ZIndex = Z.ElementBg
        presetRow.LayoutOrder = #ThemeSection.Body:GetChildren()

        local presetLbl = label(presetRow, "Themes:", 14, Palette.Text, Enum.TextXAlignment.Left, Z.ElementText)
        presetLbl.AnchorPoint = Vector2.new(0, 0.5)
        presetLbl.Position = UDim2.new(0, 0, 0.5, 0)
        presetLbl.Size = UDim2.new(0.28, 0, 0, 22)
        track("Text", presetLbl, "TextColor3")

        local presetDropdown = ThemeSection:Dropdown({
            Name = "",
            Items = { "Default", "Cherry", "Galaxy", "Red", "Sakura" },
            Default = "Default",
            Callback = function(v)
                local themes = {
                    Default = { Main=Color3.fromRGB(0x19,0x19,0x19), Inline=Color3.fromRGB(0x4B,0x4B,0x4B), Outline=Color3.fromRGB(0,0,0), Accent=Color3.fromRGB(0xFF,0xE2,0x03), Text=Color3.fromRGB(0xFF,0xFF,0xFF), TextDim=Color3.fromRGB(0x56,0x56,0x56) },
                    Cherry  = { Main=Color3.fromRGB(0x1A,0x0A,0x0F), Inline=Color3.fromRGB(0x6B,0x1F,0x2E), Outline=Color3.fromRGB(0,0,0), Accent=Color3.fromRGB(0xFF,0x4F,0x6A), Text=Color3.fromRGB(0xFF,0xFF,0xFF), TextDim=Color3.fromRGB(0xB5,0x6A,0x7A) },
                    Galaxy  = { Main=Color3.fromRGB(0x0B,0x0A,0x1A), Inline=Color3.fromRGB(0x2A,0x25,0x55), Outline=Color3.fromRGB(0,0,0), Accent=Color3.fromRGB(0x9C,0x7B,0xFF), Text=Color3.fromRGB(0xFF,0xFF,0xFF), TextDim=Color3.fromRGB(0x7A,0x72,0xB5) },
                    Red     = { Main=Color3.fromRGB(0x1A,0x0A,0x0A), Inline=Color3.fromRGB(0x5A,0x12,0x12), Outline=Color3.fromRGB(0,0,0), Accent=Color3.fromRGB(0xFF,0x2C,0x2C), Text=Color3.fromRGB(0xFF,0xFF,0xFF), TextDim=Color3.fromRGB(0xB5,0x66,0x66) },
                    Sakura  = { Main=Color3.fromRGB(0x1F,0x14,0x1A), Inline=Color3.fromRGB(0x8A,0x4A,0x6B), Outline=Color3.fromRGB(0,0,0), Accent=Color3.fromRGB(0xFF,0xB7,0xD5), Text=Color3.fromRGB(0xFF,0xFF,0xFF), TextDim=Color3.fromRGB(0xC9,0x9E,0xB5) },
                }
                local t = themes[v]
                if not t then return end
                for role, c in pairs(t) do applyRole(role, c) end
            end,
        })

        -- Reparent dropdown field into presetRow and shrink it
        if presetDropdown and presetDropdown.Row then
            local r = presetDropdown.Row
            local field = r:FindFirstChildOfClass("TextButton")
            if field then
                field.AnchorPoint = Vector2.new(1, 0.5)
                field.Position = UDim2.new(1, 0, 0.5, 0)
                field.Size = UDim2.new(0.68, 0, 0, 22)
                field.Parent = presetRow
            end
            r:Destroy()
        end

        for _, pair in ipairs({
            { "Accent",     "Accent"  },
            { "Background", "Main"    },
            { "Inline",     "Inline"  },
            { "Outline",    "Outline" },
            { "Text",       "Text"    },
            { "Text Dim",   "TextDim" },
        }) do
            ThemeSection:Colorpicker({
                Name = pair[1],
                Default = Palette[pair[2]],
                Callback = function(c) applyRole(pair[2], c) end,
            })
        end
    end

    return self
end

return Library
