-- GLOBAL CLICK-OUTSIDE REGISTRY
-- Single input handler; each dismissable overlay registers itself.
-- ============================================================
local dismissables = {}   -- { { isOpen=fn, close=fn, isInside=fn(pos) }, ... }

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local pos = input.Position
    for _, d in ipairs(dismissables) do
        if d.isOpen() then
            local ok, inside = pcall(d.isInside, pos)
            if ok and not inside then
                pcall(d.close)
            end
        end
    end
end)

